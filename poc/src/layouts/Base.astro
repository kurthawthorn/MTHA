---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titel: string;
  beskrivelse?: string;
}

const { titel, beskrivelse = 'Elitehåndbold og ungdomsuddannelse i Nykøbing Mors. ' +
  'Mors-Thy Håndbold Akademi skaber rammerne for dig, der vil udvikle dit talent.' } = Astro.props;

const fuldTitel = titel === 'forside'
  ? 'Mors-Thy Håndbold Akademi'
  : `${titel} | Mors-Thy Håndbold Akademi`;
const kanonisk = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fuldTitel}</title>
    <meta name="description" content={beskrivelse} />
    <link rel="canonical" href={kanonisk} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fuldTitel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:locale" content="da_DK" />
    <meta name="theme-color" content="#2E308D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!--
      Tænder bevægelseslaget FØR første tegning, så der ikke kommer et blink.
      Sættes kun hvis brugeren ikke har bedt om mindre bevægelse — og kun med
      JS slået til. Uden dette flag vises alt indhold straks og uden animation,
      så siden aldrig kan ende med usynlig tekst.
    -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim');
      }
    </script>

    <!-- Struktureret data: fortaeller Google at der er tale om en
         sportsorganisation med adresse. Findes ikke paa den nuvaerende side. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SportsOrganization',
      name: 'Mors-Thy Håndbold Akademi',
      sport: 'Håndbold',
      url: 'https://m-tha.dk',
      email: 'info@m-tha.dk',
      telephone: '+4530624304',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Tranevej 4',
        postalCode: '7900',
        addressLocality: 'Nykøbing Mors',
        addressCountry: 'DK',
      },
      sameAs: [
        'https://www.facebook.com/morsthyhaandboldakademi/',
        'https://www.instagram.com/mors_thy_handbold_akademi/',
      ],
    })} />
  </head>

  <body>
    <a href="#indhold" class="skip">Gå til indhold</a>

    <div class="poc-banner">
      <div class="wrap">
        <strong>POC</strong>
        <span>
          Prototype til Mors-Thy Håndbold Akademi. Navne og årgange er
          offentlige data fra m-tha.dk; øvrige spilleroplysninger er
          eksempeldata. Ikke akademiets officielle hjemmeside.
        </span>
        <a href="/admin-demo">Sådan vedligeholdes indholdet →</a>
      </div>
    </div>

    <Header />
    <main id="indhold"><slot /></main>
    <Footer />

    <script>
      // Indtoning ved rul + optælling af nøgletal. Under 900 bytes.
      // Kører kun når bevægelseslaget er tændt; ellers står alt som det er.
      if (document.documentElement.classList.contains('anim')) {
        // Sektioner uden for hero'en tones ind når de kommer i syne
        const emner = [...document.querySelectorAll<HTMLElement>('main .section')]
          .filter((s) => !s.closest('.hero, .motto'));
        emner.forEach((s) => s.setAttribute('data-reveal', ''));

        const io = new IntersectionObserver(
          (poster) => {
            for (const p of poster) {
              if (!p.isIntersecting) continue;
              p.target.classList.add('is-in');
              io.unobserve(p.target);

              // Store tal tæller op — kun én gang, og kun hele tal
              for (const el of p.target.querySelectorAll<HTMLElement>('[data-taeller]')) {
                const maal = Number(el.textContent);
                if (!Number.isFinite(maal) || maal <= 0) continue;
                const start = performance.now();
                const varighed = 900;
                const tik = (nu: number) => {
                  const t = Math.min((nu - start) / varighed, 1);
                  // ease-out, så tallet lander blødt
                  el.textContent = String(Math.round(maal * (1 - (1 - t) ** 3)));
                  if (t < 1) requestAnimationFrame(tik);
                };
                el.textContent = '0';
                requestAnimationFrame(tik);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        emner.forEach((s) => io.observe(s));
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        background: var(--orange);
        color: #241304;
        padding: 0.6rem 1rem;
        font-weight: 700;
        z-index: 10;
      }
      .skip:focus { left: 0.6rem; top: 0.6rem; }

      .poc-banner {
        background: repeating-linear-gradient(
          135deg, #2E308D 0 12px, #272a7d 12px 24px);
        color: #fff;
        font-size: 0.78rem;
        padding-block: 0.42rem;
      }
      .poc-banner .wrap { display: flex; gap: 0.6rem; align-items: baseline;
                          flex-wrap: wrap; }
      .poc-banner strong {
        font-family: var(--font-display);
        letter-spacing: 0.12em;
        background: var(--orange);
        color: #241304;
        padding: 0.05rem 0.4rem;
        border-radius: 2px;
        flex: none;
      }
      .poc-banner span { color: #C9CAEA; }
      .poc-banner a {
        margin-left: auto;
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--orange);
        text-decoration: none;
        white-space: nowrap;
      }
      .poc-banner a:hover { text-decoration: underline; }
    </style>
  </body>
</html>
