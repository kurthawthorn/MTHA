---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SponsorLogo from '../../components/SponsorLogo.astro';
import { spillere, holdFor, getSponsor } from '../../data/akademi';
import { billede } from '../../lib/billeder';
import { initials } from '../../lib/slug';

export const getStaticPaths = (() =>
  spillere.map((s) => ({ params: { spiller: s.slug }, props: { s } }))
) satisfies GetStaticPaths;

const { s } = Astro.props;
// Holdet udregnes ud fra fødselsåret — se holdFor() i akademi.ts
const h = holdFor(s);
const sponsor = getSponsor(s.sponsorId);
const sponsorNavn = sponsor?.navn ?? s.sponsorNavn;
const foto = billede(s.fotoKey);
---

<Base titel={s.navn}
      beskrivelse={`${s.navn} spiller ${s.position}${h ? ` for ${h.navn}` : ''} på Mors-Thy Håndbold Akademi.`}>
  <div class="wrap">
    <nav class="krumme" aria-label="Sti">
      <a href="/">Forside</a> <span>/</span>
      {h && <a href={`/hold/${h.id}`}>{h.navn} {h.aargang}</a>}{h && <span>/</span>}
      <span>{s.navn}</span>
    </nav>

    <article class="profil">
      <div class:list={['profil__foto', !foto && 'profil__foto--tom']}>
        {foto ? (
          <Image src={foto} alt={s.navn} widths={[320, 520, 600]}
                 sizes="(max-width: 760px) 70vw, 300px" quality={86} loading="eager" />
        ) : (
          <span class="profil__init" aria-hidden="true">{initials(s.navn)}</span>
        )}
        <span class="profil__nr num" aria-hidden="true">{s.rygnummer}</span>
      </div>

      <div class="profil__info">
        <span class="eyebrow">{h ? `${h.navn} · Årgang ${h.aargang}` : `Årgang ${s.foedselsaar}`}</span>
        <h1>{s.navn}</h1>

        <dl class="fakta">
          <div><dt>Position</dt><dd>{s.position}</dd></div>
          <div><dt>Rygnummer</dt><dd class="num">{s.rygnummer}</dd></div>
          <div><dt>Fødselsår</dt><dd class="num">{s.foedselsaar}</dd></div>
          <div><dt>Moderklub</dt><dd>{s.moderklub}</dd></div>
          <div><dt>Uddannelse</dt><dd>{s.uddannelse}</dd></div>
        </dl>

        {sponsorNavn && (
          <aside class="sponsorboks">
            <div class="sponsorboks__txt">
              <span class="eyebrow">Personlig sponsor</span>
              <strong>{sponsorNavn}</strong>
              <p>
                Logoet hentes fra sponsorregistret. Skifter sponsoren navn eller
                logo, opdateres det ét sted og slår igennem på alle de spillere
                de støtter — og i sidefoden.
              </p>
            </div>
            {sponsor && <SponsorLogo sponsor={sponsor} hoejde={46} />}
          </aside>
        )}

        <p class="demo">
          Navn, årgang, portræt og personlig sponsor er hentet fra m-tha.dk.
          Position, rygnummer, fødselsår, moderklub og uddannelse er
          eksempeldata i denne prototype.
        </p>

        {h && <a href={`/hold/${h.id}`} class="btn btn--ghost">← Hele truppen</a>}
      </div>
    </article>
  </div>
</Base>

<style>
  .krumme { display: flex; flex-wrap: wrap; gap: 0.4rem; padding-top: 1rem;
            font-size: 0.8rem; color: var(--text-faint); }
  .krumme a { color: var(--text-dim); text-decoration: none; }
  .krumme a:hover { text-decoration: underline; }

  .profil {
    display: grid; gap: 1.8rem; padding-block: 1.6rem 1rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 760px) { .profil { grid-template-columns: 19rem minmax(0, 1fr); } }

  .profil__foto {
    aspect-ratio: 3 / 4; position: relative; overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line-soft);
    background: linear-gradient(178deg, #FFFFFF 0%, #EBEDF6 100%);
    max-width: 19rem;
  }
  .profil__foto :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%;
  }
  .profil__foto--tom {
    display: grid; place-items: center;
    background: linear-gradient(168deg, var(--navy-600), var(--navy-900));
  }
  .profil__init {
    font-family: var(--font-display); font-size: 5rem; font-weight: 700;
    color: rgb(255 255 255 / 22%); letter-spacing: 0.04em;
  }
  .profil__nr {
    position: absolute; left: 0; bottom: 0;
    font-family: var(--font-display); font-size: 2.1rem; font-weight: 700;
    color: #fff; background: var(--navy); line-height: 1;
    padding: 0.3rem 0.6rem 0.36rem;
    border-top-right-radius: 4px;
  }

  .profil__info { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
  .profil h1 { font-size: clamp(1.9rem, 4.6vw, 3rem); }

  .fakta {
    margin: 0.4rem 0 0; width: 100%;
    display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 132px), 1fr));
    background: var(--line-soft);
    border: 1px solid var(--line-soft); border-radius: var(--radius);
    overflow: hidden;
  }
  .fakta > div { background: var(--surface); padding: 0.7rem 0.85rem;
                 display: flex; flex-direction: column; gap: 0.1rem; }
  .fakta dt {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.62rem; font-weight: 600; color: var(--text-faint);
  }
  .fakta dd { margin: 0; font-weight: 600; font-size: 0.95rem; }

  .sponsorboks {
    width: 100%; margin-top: 0.5rem;
    background: var(--orange-100);
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--orange);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    display: flex; flex-wrap: wrap; gap: 1rem;
    align-items: center; justify-content: space-between;
  }
  .sponsorboks__txt { display: flex; flex-direction: column; gap: 0.22rem;
                      flex: 1 1 15rem; }
  .sponsorboks strong { font-family: var(--font-display); font-size: 1.15rem;
                        text-transform: uppercase; letter-spacing: 0.02em; }
  .sponsorboks p { font-size: 0.85rem; color: var(--text-dim); }

  .demo { font-size: 0.8rem; color: var(--text-faint); max-width: 62ch; }
</style>
