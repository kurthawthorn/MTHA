---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SponsorLogo from '../../components/SponsorLogo.astro';
import Landsholdsmaerke from '../../components/Landsholdsmaerke.astro';
import { spillere, holdFor, getSponsor } from '../../data/akademi';
import { billede } from '../../lib/billeder';
import { billedUrl, billedSrcset, portraetAnker } from '../../lib/sanity';
import { initials } from '../../lib/slug';
import { redigerbar } from '../../lib/redigering';

export const getStaticPaths = (() =>
  spillere.map((s) => ({ params: { spiller: s.slug }, props: { s } }))
) satisfies GetStaticPaths;

const { s } = Astro.props;
// Holdet udregnes ud fra fødselsåret — se holdFor() i akademi.ts
const h = holdFor(s);
const sponsor = getSponsor(s.sponsorId);
const sponsorNavn = sponsor?.navn ?? s.sponsorNavn;
const fraSanity = s.fotoUrl;
const foto = fraSanity ? undefined : billede(s.fotoKey);
/* Beskæringen: redaktørens hotspot hvis der er et, ellers toppen — så hovedet
   ikke skæres af. Se portraetAnker() i lib/sanity.ts. */
const anker = portraetAnker(s.fotoHotspot);
/* Klik-til-felt i Sanitys Presentation mode. Se lib/redigering.ts. */
const red = (felt: string) => redigerbar('spiller', s.docId, felt);
---

<Base titel={s.navn}
      beskrivelse={`${s.navn} spiller ${s.position}${h ? ` for ${h.navn}` : ''} på Mors-Thy Håndbold Akademi.`}>
  <div class="wrap">
    <nav class="krumme" aria-label="Sti">
      <a href="/">Forside</a> <span>/</span>
      {h && <a href={`/hold/${h.id}`}>{h.navn} {h.aargang}</a>}{h && <span>/</span>}
      <span>{s.navn}</span>
    </nav>

    <article class="profil">
      <div class:list={['profil__foto', !foto && !fraSanity && 'profil__foto--tom']}>
        {fraSanity ? (
          <img src={billedUrl(fraSanity, { b: 520, h: 780, kvalitet: 86, ...anker })}
               srcset={billedSrcset(fraSanity, [320, 520, 600],
                                    { forhold: 3 / 2, kvalitet: 86, ...anker })}
               sizes="(max-width: 760px) 70vw, 300px"
               alt={s.navn} data-sanity={red('portraet')}
               loading="eager" decoding="async" />
        ) : foto ? (
          <Image src={foto} alt={s.navn} widths={[320, 520, 600]}
                 sizes="(max-width: 760px) 70vw, 300px" quality={86} loading="eager"
                 data-sanity={red('portraet')} />
        ) : (
          <span class="profil__init" aria-hidden="true">{initials(s.navn)}</span>
        )}
        {s.landshold && (
          <Landsholdsmaerke niveau={s.landsholdNiveau} stoerrelse="stor" />
        )}
        <span class="profil__nr num" aria-hidden="true"
              data-sanity={red('rygnummer')}>{s.rygnummer}</span>
      </div>

      <div class="profil__info">
        <span class="eyebrow">{h ? `${h.navn} · Årgang ${h.aargang}` : `Årgang ${s.foedselsaar}`}</span>
        <h1 data-sanity={red('navn')}>{s.navn}</h1>

        <dl class="fakta">
          <div><dt>Position</dt><dd data-sanity={red('position')}>{s.position}</dd></div>
          <div><dt>Rygnummer</dt><dd class="num" data-sanity={red('rygnummer')}>{s.rygnummer}</dd></div>
          <div><dt>Fødselsår</dt><dd class="num" data-sanity={red('foedselsaar')}>{s.foedselsaar}</dd></div>
          <div><dt>Moderklub</dt><dd data-sanity={red('moderklub')}>{s.moderklub}</dd></div>
          <div><dt>Uddannelse</dt><dd data-sanity={red('uddannelse')}>{s.uddannelse}</dd></div>
        </dl>

        {/*
          Sponsoren stod foer som navnet i store bogstaver med logoet ude til
          hoejre. Nu er logoet det der ses, og navnet er gaaet ind i logoets
          alt-tekst. En virksomhed genkendes paa sit maerke — det er hele
          grunden til at de har et.

          Er sponsoren ikke oprettet i registret endnu, findes der intet logo.
          Saa staar navnet, frem for en tom kasse.
        */}
        {sponsorNavn && (
          <aside class="sponsorboks" data-sanity={red('sponsor')}>
            {/* Mærkatet staar foerst i dokumentet, ikke ude til siden. Ved
                375 px falder boksen i én spalte, og saa moedte man logoet
                foer man fik at vide hvad det var. */}
            <span class="eyebrow">Personlig sponsor</span>
            <div class="sponsorboks__ind">
              {sponsor
                ? <SponsorLogo sponsor={sponsor} hoejde={54} />
                : <strong>{sponsorNavn}</strong>}
              <p>
                Logoet hentes fra sponsorregistret. Skifter sponsoren navn eller
                logo, opdateres det ét sted og slår igennem på alle de spillere
                de støtter — og i sidefoden.
              </p>
            </div>
          </aside>
        )}

        <p class="demo">
          Navn, årgang, portræt og personlig sponsor er hentet fra m-tha.dk.
          Position, rygnummer, fødselsår, moderklub og uddannelse er
          eksempeldata i denne prototype.
        </p>

        {h && <a href={`/hold/${h.id}`} class="btn btn--ghost">← Hele truppen</a>}
      </div>
    </article>
  </div>
</Base>

<style>
  .krumme { display: flex; flex-wrap: wrap; gap: 0.4rem; padding-top: 1rem;
            font-size: 0.8rem; color: var(--text-faint); }
  .krumme a { color: var(--text-dim); text-decoration: none; }
  .krumme a:hover { text-decoration: underline; }

  .profil {
    display: grid; gap: 1.8rem; padding-block: 1.6rem 1rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 760px) { .profil { grid-template-columns: 19rem minmax(0, 1fr); } }

  /* Forholdet og bundstillingen er forklaret ved --portraet i global.css:
     boksen er en smule hoejere end billedet, saa der bliver luft OVER
     hovedet frem for et snit gennem det. */
  .profil__foto {
    aspect-ratio: var(--portraet); position: relative; overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line-soft);
    background: linear-gradient(178deg, #FFFFFF 0%, #EBEDF6 100%);
    max-width: 19rem;
  }
  .profil__foto :global(img), .profil__foto img {
    width: 100%; height: 100%;
    object-fit: contain; object-position: 50% 100%;
  }
  .profil__foto--tom {
    display: grid; place-items: center;
    background: linear-gradient(168deg, var(--navy-600), var(--navy-900));
  }
  .profil__init {
    font-family: var(--font-display); font-size: 5rem; font-weight: 700;
    color: rgb(255 255 255 / 22%); letter-spacing: 0.04em;
  }
  .profil__nr {
    position: absolute; left: 0; bottom: 0;
    font-family: var(--font-display); font-size: 2.1rem; font-weight: 700;
    color: #fff; background: var(--navy); line-height: 1;
    padding: 0.3rem 0.6rem 0.36rem;
    border-top-right-radius: 4px;
  }

  .profil__info { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
  .profil h1 { font-size: clamp(1.9rem, 4.6vw, 3rem); }

  .fakta {
    margin: 0.4rem 0 0; width: 100%;
    display: grid; gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 132px), 1fr));
    background: var(--line-soft);
    border: 1px solid var(--line-soft); border-radius: var(--radius);
    overflow: hidden;
  }
  .fakta > div { background: var(--surface); padding: 0.7rem 0.85rem;
                 display: flex; flex-direction: column; gap: 0.1rem; }
  .fakta dt {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.62rem; font-weight: 600; color: var(--text-faint);
  }
  .fakta dd { margin: 0; font-weight: 600; font-size: 0.95rem; }

  /*
   * Fem felter i to spalter giver en tom celle nederst til hoejre. Fordi
   * gitterets mellemrum tegnes af foraelderens baggrund, stod den tomme plads
   * som en graa kasse — den saa ud som et felt der manglede indhold.
   *
   * Under 460 px ved vi at der er praecis to spalter, og saa kan det sidste
   * felt fylde raekken ud. Reglen staar bevidst i en media query: paa en
   * skaerm falder de fem felter paa én linje, og der ville et felt der
   * spaender over hele bredden vaere en fejl frem for en rettelse.
   */
  @media (max-width: 460px) {
    .fakta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fakta > div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }

  .sponsorboks {
    width: 100%; margin-top: 0.5rem;
    background: var(--orange-100);
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--orange);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    display: grid; gap: 0.6rem;
  }
  /* Logoet og forklaringen side om side naar der er plads, ellers under
     hinanden. `flex: none` paa logoet, saa pladen ikke bliver strakt. */
  .sponsorboks__ind {
    display: flex; flex-wrap: wrap; gap: 0.9rem 1.2rem; align-items: center;
  }
  .sponsorboks__ind > :global(.logo) { flex: none; }
  /* Bruges kun naar sponsoren ikke er oprettet i registret, og der derfor
     ikke findes noget logo at vise. */
  .sponsorboks strong { font-family: var(--font-display); font-size: 1.15rem;
                        text-transform: uppercase; letter-spacing: 0.02em; }
  .sponsorboks p { font-size: 0.85rem; color: var(--text-dim); flex: 1 1 14rem; }

  .demo { font-size: 0.8rem; color: var(--text-faint); max-width: 62ch; }
</style>
