---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NyhedsKort from '../components/NyhedsKort.astro';
import { hold, truppen, personer } from '../data/akademi';
import { billede } from '../lib/billeder';
import { MOTTO, ligatrupTal, vaerdier, titler, titelTekst } from '../data/vaerdier';

const nyheder = (await getCollection('nyheder'))
  .sort((a, b) => b.data.dato.getTime() - a.data.dato.getTime());
const seneste = nyheder.slice(0, 3);
const antalSpillere = hold.reduce((n, h) => n + truppen(h.id).length, 0);

/* Hero tåler hård komprimering (quality 58): der ligger et kraftigt navy-slør
   over fotoet, så artefakter er usynlige. Det halverer forsidens vægt. */
const heroFoto = billede('dm-2025-vinder');
const traening = ['traening-hal', 'traening-styrke', 'socialt-4'];
const faciliteter = [
  { key: 'traneholm-indgang', h: 'Traneholm', p: '35 værelser i gåafstand fra hal og skole' },
  { key: 'traneholm-koekken', h: 'Fælleskøkken', p: 'Fælles køkken og opholdsrum på hver etage' },
  { key: 'drone-2', h: 'Morsø Multipark', p: 'Haller, styrkerum og mødelokaler samlet' },
];
---

<Base titel="forside">
  <!-- Forsidens tese: det mest karakteristiske akademiet har — DM-guldet -->
  <section class="hero">
    {heroFoto && (
      <Image src={heroFoto} alt="" class="hero__bg"
             widths={[760, 1200, 1700]} sizes="100vw" quality={58} loading="eager" />
    )}
    <div class="hero__slor"></div>
    <div class="wrap hero__in">
      <div class="hero__text">
        <h1>Vi skaber<br />fremtidens stjerner</h1>
        <p class="hero__motto">”{MOTTO}”</p>

        {/* Trofæskab: årene står som medaljer, nyeste først */}
        <div class="trofae">
          <span class="trofae__label">Danmarksmestre U19</span>
          <ul class="trofae__aar">
            {titler.map((t) => (
              <li>
                <span class="num">{t.aar}</span>
                {t.resultat && <em class="num">{t.resultat}</em>}
              </li>
            ))}
          </ul>
        </div>
        <p class="lead">
          Elitehåndbold og ungdomsuddannelse samlet ét sted. Træning, skole og
          fællesskab i Morsø Multipark — med bolig i gåafstand fra hallen.
        </p>
        <div class="hero__btns">
          <a href="/bliv-elev" class="btn btn--primary">Bliv elev</a>
          <a href="/nyheder" class="btn btn--onnavy">Se nyheder</a>
        </div>
      </div>

      <dl class="hero__tal">
        <div><dt>Spillere</dt><dd class="num">{antalSpillere}</dd></div>
        <div><dt>Professionelle</dt><dd class="num">{personer.length}</dd></div>
        <div><dt>Uddannelser</dt><dd>STX · HHX · HF</dd></div>
        <div><dt>Bolig</dt><dd class="num">35 værelser</dd></div>
      </dl>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <div class="section__head">
        <h2>Seneste nyt</h2>
        <a href="/nyheder">Se alle {nyheder.length} →</a>
      </div>
      <div class="grid grid--3">
        {seneste.map((n) => (
          <NyhedsKort slug={n.id} titel={n.data.titel} dato={n.data.dato}
                      kategori={n.data.kategori} resume={n.data.resume}
                      kilde={n.data.kilde} fotoKey={n.data.fotoKey} />
        ))}
      </div>
    </section>

    <!-- Akademiets stærkeste argument. Det stod nederst på side 1 i en PDF. -->
    <section class="section">
      <a class="bevis" href="/vaerdier">
        <div class="bevis__tal">
          <strong class="num">{ligatrupTal.iMiljoeet}</strong>
          <span class="num">af {ligatrupTal.iTrup}</span>
        </div>
        <div class="bevis__txt">
          <h2>Spillere i ligatruppen kommer herfra</h2>
          <p>
            Af de {ligatrupTal.iTrup} spillere i Mors-Thy Håndbolds ligatrup
            {' '}{ligatrupTal.saeson} er eller har {ligatrupTal.iMiljoeet} været
            en del af akademiets talentmiljø.
          </p>
          <span class="bevis__link">Se vores værdier →</span>
        </div>
      </a>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Årgange</h2>
        <a href="/hold/u17">Se truppen →</a>
      </div>
      <div class="grid grid--2">
        {hold.map((h) => {
          const foto = billede(h.fotoKey);
          return (
            <a class="card holdkort" href={`/hold/${h.id}`}>
              <div class="holdkort__foto">
                {foto && (
                  <Image src={foto} alt="" widths={[420, 700, 1000]}
                         sizes="(max-width: 700px) 92vw, 520px" quality={78} loading="lazy" />
                )}
              </div>
              <div class="holdkort__txt">
                <div class="holdkort__top">
                  <h3>{h.navn} · Årgang {h.aargang}</h3>
                  <span class="pill pill--orange">{h.raekke}</span>
                </div>
                <p class="num">{truppen(h.id).length} spillere{h.traener && ` · træner ${h.traener}`}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="section__head"><h2>Træning og hverdag</h2></div>
      <div class="stribe">
        {traening.map((k) => {
          const foto = billede(k);
          return foto ? (
            <div class="stribe__i">
              <Image src={foto} alt="" widths={[400, 700]}
                     sizes="(max-width: 700px) 92vw, 360px" quality={78} loading="lazy" />
            </div>
          ) : null;
        })}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Faciliteter</h2>
        <a href="/om-akademiet">Om akademiet →</a>
      </div>
      <div class="grid grid--3">
        {faciliteter.map((f) => {
          const foto = billede(f.key);
          return (
            <div class="card fk">
              <div class="fk__foto">
                {foto && (
                  <Image src={foto} alt="" widths={[380, 640]}
                         sizes="(max-width: 700px) 92vw, 340px" quality={78} loading="lazy" />
                )}
              </div>
              <div class="fk__txt">
                <h3>{f.h}</h3>
                <p>{f.p}</p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Det vi bygger på</h2>
        <a href="/vaerdier">Alle værdier →</a>
      </div>
      <div class="grid grid--2">
        {vaerdier.slice(0, 2).map((v) => (
          <div class="card vkort">
            <h3>{v.titel}</h3>
            <p>{v.tekst}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Uddannelse</h2>
        <a href="/uddannelse">Uddannelse og eliteidræt →</a>
      </div>
      <div class="grid grid--3">
        <div class="card vkort">
          <h3>Fire veje</h3>
          <p>STX, HHX og EUX Business, HF — eller en erhvervsuddannelse med
             læreplads hos en lokal virksomhed.</p>
        </div>
        <div class="card vkort">
          <h3>Koordinator hele vejen</h3>
          <p>Fra de indledende samtaler til afgangsprøven er der en koordinator
             tilknyttet på uddannelsesstedet.</p>
        </div>
        <div class="card vkort">
          <h3>Skemaet hænger sammen</h3>
          <p>Trænere, lærere, koordinator og elev planlægger udviklingen
             sammen. Der er lektiehjælp på akademiet og på skolerne.</p>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    color: #fff;
    padding-block: clamp(3.4rem, 9vw, 7rem) clamp(2rem, 5vw, 3.4rem);
    overflow: hidden;
    background: var(--navy-900);
  }
  .hero :global(.hero__bg) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 32%;
  }
  /* Slør: fotoet er lyst og fyldt med detaljer, saa teksten skal have baggrund */
  .hero__slor {
    position: absolute; inset: 0;
    background:
      linear-gradient(100deg, rgb(20 22 78 / 92%) 0%, rgb(24 26 84 / 74%) 44%,
                              rgb(24 26 84 / 22%) 78%),
      linear-gradient(0deg, rgb(11 13 46 / 72%) 0%, transparent 55%);
  }
  .hero__in {
    position: relative;
    display: grid; gap: 2.2rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
  }
  @media (min-width: 900px) {
    .hero__in { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); }
  }
  .hero__text { display: flex; flex-direction: column; gap: 0.9rem; }
  .hero h1 {
    font-size: clamp(2.3rem, 6.6vw, 4.4rem);
    letter-spacing: -0.005em;
    text-shadow: 0 2px 24px rgb(11 13 46 / 55%);
  }
  .hero .lead { color: #D6D7F0; }
  .hero__motto {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.04em; font-size: clamp(0.95rem, 2.2vw, 1.3rem);
    font-weight: 700; color: var(--orange);
  }
  .hero .eyebrow { color: var(--orange); }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.4rem; }

  /* Medaljerne: guldkant og orange årstal, som en række pokaler i et skab */
  .trofae { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 0.2rem; }
  .trofae__label {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.16em; font-size: 0.66rem; font-weight: 600; color: #A8ABDC;
  }
  .trofae__aar { list-style: none; margin: 0; padding: 0; display: flex;
                 flex-wrap: wrap; gap: 0.5rem; }
  .trofae__aar li {
    display: flex; flex-direction: column; align-items: center; gap: 0.05rem;
    background: rgb(255 255 255 / 10%);
    border: 1px solid var(--orange);
    border-radius: var(--radius);
    padding: 0.34rem 0.7rem 0.4rem;
    backdrop-filter: blur(3px);
  }
  .trofae__aar li span {
    font-family: var(--font-display); font-weight: 700;
    font-size: 1.32rem; line-height: 1; color: var(--orange);
  }
  .trofae__aar li em {
    font-style: normal; font-family: var(--font-mono);
    font-size: 0.62rem; color: #BDBFE6;
  }

  .hero__tal {
    margin: 0;
    display: grid; gap: 1px;
    grid-template-columns: repeat(2, 1fr);
    background: rgb(255 255 255 / 22%);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius);
    overflow: hidden;
    backdrop-filter: blur(3px);
  }
  .hero__tal > div {
    background: rgb(23 25 80 / 78%);
    padding: 0.85rem 0.9rem;
    display: flex; flex-direction: column; gap: 0.1rem;
  }
  .hero__tal dt {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.63rem; font-weight: 600; color: #A8ABDC;
  }
  .hero__tal dd {
    margin: 0; font-family: var(--font-display); font-weight: 700;
    font-size: 1.45rem; line-height: 1.1;
  }

  .holdkort { padding: 0; }
  .holdkort__foto {
    aspect-ratio: 16 / 7; overflow: hidden; background: var(--navy-800);
  }
  .holdkort__foto :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.4s ease;
  }
  a.card:hover .holdkort__foto :global(img) { transform: scale(1.03); }
  .holdkort__txt {
    padding: 0.9rem 1.1rem 1.05rem;
    display: flex; flex-direction: column; gap: 0.28rem;
    border-top: 2px solid var(--orange);
  }
  .holdkort__top { display: flex; align-items: center; gap: 0.7rem;
                   justify-content: space-between; flex-wrap: wrap; }
  .holdkort h3 { font-size: 1.05rem; }
  .holdkort__txt p { color: var(--text-dim); font-size: 0.88rem; }

  .stribe {
    display: grid; gap: 0.7rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  .stribe__i {
    aspect-ratio: 4 / 3; overflow: hidden;
    border-radius: var(--radius); border: 1px solid var(--line-soft);
    background: var(--surface-2);
  }
  .stribe__i :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .fk { padding: 0; }
  .fk__foto { aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2); }
  .fk__foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .fk__txt { padding: 0.85rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .fk h3 { font-size: 1rem; }
  .fk p { font-size: 0.9rem; color: var(--text-dim); }
</style>
