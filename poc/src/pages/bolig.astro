---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { boliger, boligFordele } from '../data/oekonomi';
import { billede } from '../lib/billeder';
import { altFor } from '../data/billeder';

const kr = (n: number) => `${n.toLocaleString('da-DK')} kr.`;
const rabat = (b: typeof boliger[number]) =>
  Math.round((1 - b.indskud / b.indskudFoer) * 100);

const fotos = ['traneholm-indgang', 'traneholm-koekken', 'traneholm-ophold'];
---

<Base titel="Bolig på Traneholm"
      beskrivelse="Ungdomsboliger i Traneholm College tæt på Morsø Gymnasium og Mors-Thy Håndbold Akademi. Husleje fra 2.640 kr. og reduceret indskud.">
  <div class="wrap">
    <nav class="krumme" aria-label="Sti">
      <a href="/">Forside</a> <span>/</span> <span>Bolig</span>
    </nav>

    <header class="top">
      <span class="eyebrow">Traneholm College · Nykøbing Mors</span>
      <h1>Bolig i gåafstand fra hallen</h1>
      <p class="lead">
        Egen lejlighed med køkken, bad og toilet — tæt på Morsø Gymnasium,
        Morsø Handelsgymnasium og akademiets faciliteter. Internet er med i
        huslejen.
      </p>
    </header>

    <section class="section">
      <div class="galleri">
        {fotos.map((k) => {
          const f = billede(k);
          return f ? (
            <figure class="galleri__i">
              <Image src={f} alt={altFor(k)} widths={[420, 760]}
                     sizes="(max-width: 720px) 92vw, 360px" quality={80} loading="lazy" />
            </figure>
          ) : null;
        })}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Boligtyper og priser</h2>
        <span class="antal num">{boliger.length} typer</span>
      </div>

      <div class="tblwrap">
        <table>
          <caption>
            Boligselskabet Nykøbing Mors har reduceret indskuddet med omkring
            50 %. Husleje er ekskl. forbrug.
          </caption>
          <thead>
            <tr>
              <th scope="col">Bolig</th>
              <th scope="col" class="n">Størrelse</th>
              <th scope="col" class="n">Husleje/md</th>
              <th scope="col" class="n">Indskud</th>
              <th scope="col" class="n">Før</th>
              <th scope="col" class="n">Rabat</th>
            </tr>
          </thead>
          <tbody>
            {boliger.map((b) => (
              <tr>
                <td>{b.rum} {b.rum === 1 ? 'rum' : 'rum'}</td>
                <td class="n num">{b.kvm} m²</td>
                <td class="n num">{kr(b.husleje)}</td>
                <td class="n num strong">{kr(b.indskud)}</td>
                <td class="n num foer">{kr(b.indskudFoer)}</td>
                <td class="n num rabat">−{rabat(b)} %</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="note">
        Tallene er hentet ud af Domea-flyeren, der i dag ligger som en PDF på
        m-tha.dk. Som tabel kan de sorteres, sammenlignes og rettes ét sted —
        og Google kan læse dem.
      </p>
    </section>

    <section class="section">
      <div class="section__head"><h2>Det får du</h2></div>
      <ul class="liste">
        {boligFordele.map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="card cta">
        <h2>Interesseret i en bolig?</h2>
        <p>
          Boligerne udlejes af Boligselskabet Nykøbing Mors. Ring til dem
          direkte, eller tag fat i akademiet hvis du vil have hjælp til
          rækkefølgen.
        </p>
        <div class="cta__btns">
          <a href="tel:+4576444600" class="btn btn--primary">76 44 46 00</a>
          <a href="/bliv-elev/oekonomi" class="btn btn--ghost">Se hele økonomien</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .krumme { display: flex; flex-wrap: wrap; gap: 0.4rem; padding-top: 1rem;
            font-size: 0.8rem; color: var(--text-faint); }
  .krumme a { color: var(--text-dim); text-decoration: none; }
  .krumme a:hover { text-decoration: underline; }

  .top { display: flex; flex-direction: column; gap: 0.5rem;
         padding-block: 1.4rem 1.1rem; border-bottom: 2px solid var(--navy); }
  .top h1 { font-size: clamp(1.9rem, 4.8vw, 3rem); }
  .antal { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-faint); }

  .galleri { display: grid; gap: 0.7rem;
             grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .galleri__i { margin: 0; aspect-ratio: 4 / 3; overflow: hidden;
                border-radius: var(--radius); border: 1px solid var(--line-soft);
                background: var(--surface-2); }
  .galleri__i :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .tblwrap { overflow-x: auto; border: 1px solid var(--line-soft);
             border-radius: var(--radius); }
  table { border-collapse: collapse; width: 100%; min-width: 34rem; font-size: 0.93rem; }
  caption { text-align: left; padding: 0.75rem 1rem; font-size: 0.8rem;
            color: var(--text-faint); border-bottom: 1px solid var(--line-soft);
            max-width: 60ch; }
  th, td { text-align: left; padding: 0.6rem 1rem; border-bottom: 1px solid var(--line-soft); }
  th { font-family: var(--font-display); text-transform: uppercase;
       letter-spacing: 0.09em; font-size: 0.66rem; color: var(--text-dim);
       background: var(--surface-2); }
  td { color: var(--text-dim); }
  td:first-child { color: var(--text); font-weight: 600; }
  .n { text-align: right; white-space: nowrap; }
  .strong { color: var(--text); font-weight: 650; }
  .foer { color: var(--text-faint); text-decoration: line-through; }
  .rabat { color: var(--good); font-weight: 650; }
  tbody tr:last-child td { border-bottom: 0; }

  .liste { margin: 0; padding: 0; list-style: none;
           display: flex; flex-direction: column; gap: 0.42rem; max-width: 68ch; }
  .liste li { padding-left: 1.4rem; position: relative; color: var(--text-dim); }
  .liste li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 7px; height: 7px; border-radius: 50%; background: var(--orange);
  }

  .note { font-size: 0.82rem; color: var(--text-faint); margin-top: 0.9rem;
          max-width: 68ch; }

  .cta { padding: 1.6rem 1.7rem; gap: 0.6rem; align-items: flex-start;
         background: var(--surface-2); }
  .cta h2 { font-size: 1.3rem; }
  .cta p { color: var(--text-dim); max-width: 58ch; }
  .cta__btns { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.4rem; }
</style>
