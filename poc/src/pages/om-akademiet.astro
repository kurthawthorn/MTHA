---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { billede } from '../lib/billeder';
import { saeson } from '../data/saeson';
import { altFor, iKategori } from '../data/billeder';

const faciliteter = [
  { key: 'drone-2', h: 'Morsø Multipark',
    p: 'Akademiets base med haller, styrkerum og mødelokaler samlet ét sted.' },
  { key: 'multipark-front', h: 'Sparekassen Thy Arena | Mors',
    p: 'Hjemmebane for kampe og en del af den daglige træning.' },
  { key: 'traneholm-indgang', h: 'Traneholm',
    p: `${saeson.vaerelser} værelser i kollegielignende bolig i gåafstand fra hal og uddannelse.` },
  { key: 'traneholm-koekken', h: 'Fælleskøkken',
    p: 'Fælleskøkken og opholdsrum på hver etage.' },
  { key: 'traneholm-ophold', h: 'Opholdsrum',
    p: 'Plads til at falde ned efter træning — med biografstole.' },
  { key: 'drone-3', h: 'Området',
    p: 'Hal, bolig og uddannelse ligger inden for gåafstand af hinanden.' },
];

const traening = ['traening-hal', 'traening-styrke'];
const socialt = iKategori('fotos', 'socialt').map((f) => f.key);
const top = billede('hold-udenfor');
---

<Base titel="Om akademiet"
      beskrivelse="Mors-Thy Håndbold Akademi kombinerer elitehåndbold med ungdomsuddannelse i Nykøbing Mors.">
  <div class="wrap">
    {top && (
      <div class="topfoto">
        <Image src={top} alt={altFor('hold-udenfor')} widths={[900, 1500, 2200]}
               sizes="100vw" quality={80} loading="eager" />
      </div>
    )}

    <header class="top">
      <span class="eyebrow">Træning · uddannelse · fællesskab</span>
      <h1>Om akademiet</h1>
      <p class="lead">
        Mors-Thy Håndbold Akademi vil gennem træning, uddannelse og fællesskab
        være det foretrukne valg for motiverede unge elitehåndboldspillere.
      </p>
    </header>

    <section class="section prose">
      <h2>Vision</h2>
      <p>
        Som elev på akademiet får du hjælp til at planlægge og strukturere din
        skolegang, så den hænger sammen med elitesport. Trænerne har
        DHF-uddannelse og mange års erfaring, og flere er selv en del af
        Mors-Thy Håndbolds ligatrup.
      </p>
      <p>
        Der er stort fokus på elevernes fysiske udvikling. Fysioterapeuter fra
        Morsø Fysiologi står for skadesforebyggende træning, og en mentaltræner
        er tilknyttet hverdagen.
      </p>
      <p>
        <a href="/vaerdier">Læs om akademiets værdier →</a><br />
        <a href="/staben">Se hele staben omkring akademiet →</a>
      </p>
    </section>

    <section class="section">
      <div class="section__head"><h2>Fysisk udvikling</h2></div>
      <div class="par">
        {traening.map((k) => {
          const f = billede(k);
          return f ? (
            <figure class="par__i">
              <Image src={f} alt={altFor(k)} widths={[460, 820]}
                     sizes="(max-width: 700px) 92vw, 460px" quality={80} loading="lazy" />
            </figure>
          ) : null;
        })}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Uddannelse og eliteidræt</h2>
        <a href="/uddannelse">Se alle fire veje →</a>
      </div>
      <p class="lead">
        Det er et krav, at opholdet kombineres med en ungdomsuddannelse. Der er
        en koordinator på hvert uddannelsessted, lektiehjælp og et skema, der er
        lagt så træning og undervisning går op.
      </p>
    </section>

    <section class="section">
      <div class="section__head"><h2>Faciliteter</h2></div>
      <div class="grid grid--3">
        {faciliteter.map((f) => {
          const foto = billede(f.key);
          return (
            <div class="card fk">
              <div class="fk__foto">
                {foto && (
                  <Image src={foto} alt={altFor(f.key)} widths={[380, 660]}
                         sizes="(max-width: 700px) 92vw, 340px" quality={78} loading="lazy" />
                )}
              </div>
              <div class="fk__txt">
                <h3>{f.h}</h3>
                <p>{f.p}</p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    {socialt.length > 0 && (
      <section class="section">
        <div class="section__head"><h2>Hverdagen</h2></div>
        <div class="galleri">
          {socialt.map((k) => {
            const f = billede(k);
            return f ? (
              <div class="galleri__i">
                <Image src={f} alt={altFor(k)} widths={[300, 560]}
                       sizes="(max-width: 700px) 45vw, 240px" quality={78} loading="lazy" />
              </div>
            ) : null;
          })}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .topfoto {
    margin-top: 1rem;
    aspect-ratio: 24 / 7; overflow: hidden;
    border-radius: var(--radius); border: 1px solid var(--line-soft);
    background: var(--navy-800);
  }
  .topfoto :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .top { display: flex; flex-direction: column; gap: 0.5rem;
         padding-block: 1.4rem 1.1rem; border-bottom: 2px solid var(--navy); }
  .top h1 { font-size: clamp(1.9rem, 4.8vw, 3rem); }

  .kort { padding: var(--rum-5); gap: 0.35rem; }
  .kort h3 { font-size: 1.02rem; }
  .kort p { font-size: 0.92rem; color: var(--text-dim); }

  .par { display: grid; gap: 0.8rem;
         grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .par__i { margin: 0; aspect-ratio: 4 / 3; overflow: hidden;
            border-radius: var(--radius); border: 1px solid var(--line-soft);
            background: var(--surface-2); }
  .par__i :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .fk { padding: 0; }
  .fk__foto { aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2); }
  .fk__foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .fk__txt { padding: 0.85rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .fk h3 { font-size: 1rem; }
  .fk p { font-size: 0.9rem; color: var(--text-dim); }

  .galleri { display: grid; gap: 0.6rem;
             grid-template-columns: repeat(auto-fill, minmax(min(45%, 170px), 1fr)); }
  .galleri__i { aspect-ratio: 3 / 4; overflow: hidden;
                border-radius: var(--radius); border: 1px solid var(--line-soft);
                background: var(--surface-2); }
  .galleri__i :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
