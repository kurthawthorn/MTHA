---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import RigTekst from '../../components/RigTekst.astro';
import { nyheder } from '../../data/nyheder';
import { billede } from '../../lib/billeder';
import { billedUrl, billedSrcset } from '../../lib/sanity';
import { danishDate } from '../../lib/slug';
import { getHold } from '../../data/akademi';
import { redigerbar } from '../../lib/redigering';
import { Image } from 'astro:assets';

export const getStaticPaths = (() =>
  nyheder.map((n) => ({ params: { slug: n.slug }, props: { n } }))
) satisfies GetStaticPaths;

const { n } = Astro.props;
const h = n.holdId ? getHold(n.holdId) : undefined;
const fraSanity = n.fotoUrl;
const lokal = fraSanity ? undefined : billede(n.fotoKey);
/* Klik-til-felt i Sanitys Presentation mode. Se lib/redigering.ts. */
const red = (felt: string) => redigerbar('nyhed', n.docId, felt);
---

<Base titel={n.titel} beskrivelse={n.resume}>
  <div class="wrap">
    <nav class="krumme" aria-label="Sti">
      <a href="/">Forside</a> <span>/</span>
      <a href="/nyheder">Nyheder</a> <span>/</span>
      <span>{n.titel}</span>
    </nav>

    <article class="artikel">
      <header class="artikel__top">
        <div class="artikel__meta">
          <span class="pill" data-sanity={red('kategori')}>{n.kategori}</span>
          <time datetime={n.dato.toISOString()} data-sanity={red('dato')}>{danishDate(n.dato)}</time>
          {n.kilde === 'instagram' && <span class="via">hentet fra Instagram</span>}
        </div>
        <h1 data-sanity={red('titel')}>{n.titel}</h1>
        <p class="lead" data-sanity={red('resume')}>{n.resume}</p>
        {h && <a href={`/hold/${h.id}`} class="artikel__hold">{h.navn} · årgang {h.aargang}</a>}
      </header>

      {(fraSanity || lokal) && (
        <figure class="artikel__foto">
          {fraSanity ? (
            <img src={billedUrl(fraSanity, { b: 1100, kvalitet: 82 })}
                 srcset={billedSrcset(fraSanity, [700, 1100, 1600], { kvalitet: 82 })}
                 sizes="(max-width: 800px) 94vw, 700px"
                 alt={n.titel} data-sanity={red('foto')}
                 loading="eager" decoding="async" />
          ) : (
            <Image src={lokal!} alt={n.titel} widths={[700, 1100, 1600]}
                   sizes="(max-width: 800px) 94vw, 700px" quality={82} loading="eager" />
          )}
        </figure>
      )}

      <div class="artikel__krop" data-sanity={red('indhold')}>
        <RigTekst blokke={n.indhold} />
      </div>
    </article>

    <a href="/nyheder" class="btn btn--ghost tilbage">← Alle nyheder</a>
  </div>
</Base>

<style>
  .krumme { display: flex; flex-wrap: wrap; gap: 0.4rem; padding-top: 1rem;
            font-size: 0.8rem; color: var(--text-faint); }
  .krumme a { color: var(--text-dim); text-decoration: none; }
  .krumme a:hover { text-decoration: underline; }

  .artikel { max-width: 68ch; padding-block: 1.6rem 0; }
  .artikel__top { display: flex; flex-direction: column; gap: 0.6rem;
                  padding-bottom: 1.2rem; border-bottom: 1px solid var(--line); }
  .artikel__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .artikel__meta time { font-family: var(--font-mono); font-size: 0.76rem;
                        color: var(--text-faint); }
  .via {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.1em; font-size: 0.6rem; font-weight: 600;
    color: var(--text-faint); border: 1px solid var(--line);
    padding: 0.12rem 0.4rem; border-radius: 2px;
  }
  .artikel h1 { font-size: clamp(1.8rem, 4.6vw, 2.8rem); }
  .artikel__hold {
    align-self: flex-start; font-family: var(--font-display);
    text-transform: uppercase; letter-spacing: 0.08em;
    font-size: 0.76rem; font-weight: 600; text-decoration: none;
    color: var(--navy-600); border-bottom: 2px solid var(--orange);
  }
  .artikel__foto {
    margin: 1.3rem 0 0;
    border-radius: var(--radius); overflow: hidden;
    border: 1px solid var(--line-soft); background: var(--surface-2);
  }
  .artikel__foto :global(img), .artikel__foto img {
    width: 100%; height: auto; display: block;
  }
  .artikel__krop { padding-block: 1.3rem; }
  .tilbage { margin-bottom: 1rem; }
</style>
