---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { personer, iSektion, SEKTION_NAVNE } from '../data/akademi';
import { billede } from '../lib/billeder';
import { billedUrl, billedSrcset, portraetAnker } from '../lib/sanity';
import { initials } from '../lib/slug';
import { redigerbar } from '../lib/redigering';

/* Sektionerne er dem der faktisk står på m-tha.dk — fundet ved at læse
   overskrifterne i deres HTML, ikke gættet ud fra rollen. */
const grupper = (['professionel', 'ansat', 'bestyrelse'] as const)
  .map((s) => ({ id: s, navn: SEKTION_NAVNE[s], folk: iSektion(s) }))
  .filter((g) => g.folk.length > 0);
---

<Base titel="Staben"
      beskrivelse="Trænere, fysioterapeuter, uddannelseskoordinatorer og bestyrelse omkring Mors-Thy Håndbold Akademi.">
  <div class="wrap">
    <header class="top">
      <span class="eyebrow">{personer.length} professionelle omkring akademiet</span>
      <h1>Staben</h1>
      <p class="lead">
        Trænere med DHF-uddannelse, fysioterapeuter fra Morsø Fysiologi,
        uddannelseskoordinatorer på hvert af de tre uddannelsessteder — og en
        bestyrelse bag det hele. Grupperingen følger akademiets egen inddeling.
      </p>
    </header>

    {grupper.map((g) => (
      <section class="section">
        <div class="section__head">
          <h2>{g.navn}</h2>
          <span class="antal num">{g.folk.length}</span>
        </div>
        <div class="grid personer">
          {g.folk.map((p) => {
            const fraSanity = p.fotoUrl;
            const foto = fraSanity ? undefined : billede(p.fotoKey);
            /* Samme portrætter som spillerne — 600 × 900 og næsten ingen luft
               over hovedet. Derfor samme beskæring. Se portraetAnker(). */
            const anker = portraetAnker(p.fotoHotspot);
            const red = (felt: string) => redigerbar('person', p.docId, felt);
            return (
              <article class="card pk">
                <div class:list={['pk__foto', !foto && !fraSanity && 'pk__foto--tom']}>
                  {fraSanity ? (
                    <img src={billedUrl(fraSanity, { b: 300, h: 450, ...anker })}
                         srcset={billedSrcset(fraSanity, [180, 300], { forhold: 3 / 2, ...anker })}
                         sizes="180px" alt={p.navn} data-sanity={red('portraet')}
                         loading="lazy" decoding="async" />
                  ) : foto ? (
                    <Image src={foto} alt={p.navn} widths={[180, 300]}
                           sizes="180px" quality={82} loading="lazy"
                           data-sanity={red('portraet')} />
                  ) : (
                    <span aria-hidden="true">{initials(p.navn)}</span>
                  )}
                </div>
                <div class="pk__txt">
                  <h3 data-sanity={red('navn')}>{p.navn}</h3>
                  {p.rolle
                    ? <p class="pk__rolle" data-sanity={red('rolle')}>{p.rolle}</p>
                    : <p class="pk__mangler" data-sanity={red('rolle')}>Rolle udfyldes af akademiet</p>}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}

    <p class="note">
      Navne, roller, portrætter og inddelingen i sektioner er hentet fra
      m-tha.dk. De personer der står uden rolle står også uden titel på den
      nuværende side — feltet er klar, så akademiet selv kan udfylde det.
    </p>
  </div>
</Base>

<style>
  .top { display: flex; flex-direction: column; gap: 0.5rem;
         padding-block: 1.8rem 1.1rem; border-bottom: 2px solid var(--navy); }
  .top h1 { font-size: clamp(1.9rem, 4.8vw, 3rem); }
  .antal { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-faint); }

  /*
   * 168px var 14px for meget.
   *
   * Ved 375 px er indholdsbredden 335 px. To spalter kræver 2 x 168 + 13,6 px
   * mellemrum = 349,6 px, og saa faldt gitteret ned i ÉN spalte: ét portraet
   * paa 335 x 536 px pr. person, 25 gange. Truppen brugte 158 px og laa
   * dermed lige under graensen — derfor stod de to sider forskelligt uden at
   * nogen havde besluttet det.
   *
   * 150 px giver to spalter ved 375 px med luft til overs, og aendrer intet
   * paa en skaerm, hvor gitteret alligevel fylder ud.
   */
  .personer { grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
              gap: 0.85rem; }
  .pk { padding: 0; }
  /* Samme forhold og bundstilling som spillerkortet — se --portraet i
     global.css. Var det kun rettet på spillerne, ville halvdelen af sitet
     skære hovedet af på de samme fotos. */
  .pk__foto {
    aspect-ratio: var(--portraet); overflow: hidden;
    background: linear-gradient(178deg, #FFFFFF 0%, #EEF0F7 100%);
  }
  .pk__foto :global(img), .pk__foto img {
    width: 100%; height: 100%;
    object-fit: contain; object-position: 50% 100%;
  }
  .pk__foto--tom {
    display: grid; place-items: center;
    background: linear-gradient(168deg, var(--navy-600), var(--navy-800));
  }
  .pk__foto--tom span {
    font-family: var(--font-display); font-size: 1.9rem; font-weight: 700;
    color: rgb(255 255 255 / 26%);
  }
  .pk__txt {
    padding: 0.55rem 0.7rem 0.72rem;
    border-top: 2px solid var(--orange);
    display: flex; flex-direction: column; gap: 0.1rem;
  }
  .pk h3 { font-size: 0.82rem; letter-spacing: 0.01em; }
  .pk__rolle { font-size: 0.74rem; color: var(--text-dim); }
  .pk__mangler { font-size: 0.72rem; color: var(--text-faint); font-style: italic; }

  .note { font-size: 0.84rem; color: var(--text-faint); max-width: 64ch;
          padding-bottom: 1rem; }
</style>
