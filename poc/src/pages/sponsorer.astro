---
import Base from '../layouts/Base.astro';
import SponsorLogo from '../components/SponsorLogo.astro';
import { sponsorerPaaNiveau, hovedsponsor, spillere, getSponsor } from '../data/akademi';

const hoved = hovedsponsor();
const top = sponsorerPaaNiveau('topsponsor');
const oevrige = sponsorerPaaNiveau('sponsor');
const partnere = sponsorerPaaNiveau('partner');

// Optalt automatisk ud fra spillerprofilerne — ikke vedligeholdt i hånden
const personlige = new Map<string, number>();
for (const s of spillere) {
  if (s.sponsorId) personlige.set(s.sponsorId, (personlige.get(s.sponsorId) ?? 0) + 1);
}
const medPersonlige = [...personlige.entries()]
  .map(([id, antal]) => ({ sponsor: getSponsor(id)!, antal }))
  .filter((x) => x.sponsor)
  .sort((a, b) => b.antal - a.antal);
---

<Base titel="Sponsorer"
      beskrivelse="Mors-Thy Håndbold Akademi støttes af Thisted Forsikring og over 40 lokale virksomheder.">
  <div class="wrap">
    <header class="top">
      <span class="eyebrow">Uden dem, intet akademi</span>
      <h1>Sponsorer</h1>
      <p class="lead">
        Alle {top.length + oevrige.length + 1} sponsorer og {partnere.length}
        samarbejdspartnere ligger i ét register — med logo og link. Et logo
        uploades én gang og vises automatisk her, i sidefoden og på de
        spillerkort sponsoren støtter.
      </p>
    </header>

    <section class="section">
      <div class="section__head"><h2>Hovedsponsor</h2></div>
      <a class="card hoved" href={hoved.url} rel="noopener" target="_blank">
        <img src="/brand/thisted-forsikring.png" alt={hoved.navn}
             width="314" height="173" />
        <div>
          <h3>{hoved.navn}</h3>
          <p>
            Hovedsponsor for Mors-Thy Håndbold Akademi. Logoet er skilt ud fra
            akademiets eget mærke, så de to kan bruges hver for sig.
          </p>
        </div>
      </a>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Topsponsorer</h2>
        <span class="antal num">{top.length}</span>
      </div>
      <div class="logogrid logogrid--stor">
        {top.map((s) => <SponsorLogo sponsor={s} hoejde={60} redigerbart />)}
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Sponsorer</h2>
        <span class="antal num">{oevrige.length} virksomheder</span>
      </div>
      <div class="logogrid">
        {oevrige.map((s) => <SponsorLogo sponsor={s} hoejde={46} redigerbart />)}
      </div>
      <p class="note">
        Logoerne er akademiets egne filer fra m-tha.dk, og hvert enkelt linker
        til sponsorens egen hjemmeside. De kommer i vidt forskellige formater —
        nogle med transparent baggrund, nogle på hvid — så de står alle på en
        plade med samme højde, for at rækken bliver rolig.
      </p>
    </section>

    {partnere.length > 0 && (
      <section class="section">
        <div class="section__head">
          <h2>Samarbejdspartnere</h2>
          <span class="antal num">{partnere.length}</span>
        </div>
        <div class="logogrid logogrid--stor">
          {partnere.map((s) => <SponsorLogo sponsor={s} hoejde={52} redigerbart />)}
        </div>
      </section>
    )}

    {medPersonlige.length > 0 && (
      <section class="section">
        <div class="section__head"><h2>Personlige spillersponsorer</h2></div>
        <ul class="liste">
          {medPersonlige.map(({ sponsor, antal }) => (
            <li>
              <span>{sponsor.navn}</span>
              <em class="num">støtter {antal} {antal === 1 ? 'spiller' : 'spillere'}</em>
            </li>
          ))}
        </ul>
        <p class="note">
          Alle 54 spillere har en personlig sponsor, og koblingerne er
          akademiets egne — hentet fra m-tha.dk. Tallene til højre er talt op
          automatisk ud fra spillerprofilerne, så de aldrig kan komme til at
          passe dårligt.
        </p>
      </section>
    )}

    <section class="section">
      <div class="card cta">
        <h2>Bliv sponsor</h2>
        <p>
          Vil I støtte talentudviklingen på Mors og i Thy — som virksomhed eller
          som personlig sponsor for en enkelt elev?
        </p>
        <a href="mailto:info@m-tha.dk" class="btn btn--primary">Skriv til akademiet</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .top { display: flex; flex-direction: column; gap: 0.5rem;
         padding-block: 1.8rem 1.1rem; border-bottom: 2px solid var(--navy); }
  .top h1 { font-size: clamp(1.9rem, 4.8vw, 3rem); }
  .antal { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-faint); }

  .hoved {
    flex-direction: row; align-items: center; gap: 1.4rem;
    padding: 1.3rem 1.5rem; flex-wrap: wrap; text-decoration: none; color: inherit;
  }
  .hoved img { width: auto; height: 76px; background: #fff;
               border-radius: var(--radius); padding: 0.3rem 0.5rem; }
  .hoved h3 { font-size: 1.3rem; }
  .hoved p { color: var(--text-dim); font-size: 0.92rem; max-width: 46ch; }

  .logogrid {
    display: grid; gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 132px), 1fr));
  }
  .logogrid--stor {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
  }

  .liste { list-style: none; margin: 0; padding: 0;
           border-top: 1px solid var(--line-soft); }
  .liste li {
    display: flex; flex-wrap: wrap; gap: 0.3rem 1rem;
    justify-content: space-between; align-items: baseline;
    padding: 0.6rem 0.2rem; border-bottom: 1px solid var(--line-soft);
  }
  .liste span { font-weight: 600; }
  .liste em { font-style: normal; font-size: 0.8rem; color: var(--text-faint); }

  .note { font-size: 0.82rem; color: var(--text-faint); margin-top: 0.9rem;
          max-width: 66ch; }

  .cta { padding: 1.6rem 1.7rem; gap: 0.6rem; align-items: flex-start;
         background: var(--surface-2); }
  .cta h2 { font-size: 1.3rem; }
  .cta p { color: var(--text-dim); max-width: 56ch; }
  .cta .btn { margin-top: 0.4rem; }
</style>
