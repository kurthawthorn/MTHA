---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FeltTabel from '../components/FeltTabel.astro';
import type { Felt, Slags } from '../components/FeltTabel.astro';
import {
  spillere, holdFor, getSponsor, truppen, personer, iSektion,
  sponsorerPaaNiveau, SEKTION_NAVNE,
} from '../data/akademi';
import { saeson } from '../data/saeson';
import { billede } from '../lib/billeder';

/**
 * Demonstration af redigeringsvinduet — ikke et rigtigt CMS.
 *
 * Viser de tre korttyper akademiet skal vedligeholde: spiller, person i
 * staben, og sponsor. For hver: hvilke felter der findes, og hvornår de skal
 * røres. Feltopdelingen er hele pointen:
 *
 *   stamdata   udfyldes én gang, ændres aldrig
 *   sæson      kan ændre sig fra sæson til sæson
 *   udregnet   kan ikke redigeres — systemet finder selv frem til det
 *
 * Alle værdier er faktiske data fra roster.json.
 */

/* ── Spiller ──────────────────────────────────────────────────────────── */
const sp = spillere.find((x) => x.slug === 'joakim-lindum') ?? spillere[0]!;
const spHold = holdFor(sp);
const spSponsor = getSponsor(sp.sponsorId);
const spAargange = saeson.hold.find((x) => x.id === spHold?.id)?.foedselsaar ?? [];

const spillerFelter: Felt[] = [
  { navn: 'Navn', vaerdi: sp.navn, slags: 'stam', type: 'tekst' },
  { navn: 'Portræt', vaerdi: `${sp.fotoKey}.jpg`, slags: 'stam', type: 'billede',
    hjaelp: 'Træk et foto ind. Beskæring om ansigtet og WebP sker automatisk' },
  { navn: 'Fødselsår', vaerdi: String(sp.foedselsaar), slags: 'stam', type: 'tal',
    hjaelp: 'Det vigtigste felt — holdet udregnes herudfra. Ændres aldrig' },
  { navn: 'Moderklub', vaerdi: sp.moderklub, slags: 'stam', type: 'tekst' },
  { navn: 'Rygnummer', vaerdi: String(sp.rygnummer), slags: 'saeson', type: 'tal' },
  { navn: 'Position', vaerdi: sp.position, slags: 'saeson', type: 'valg' },
  { navn: 'Uddannelse', vaerdi: sp.uddannelse, slags: 'saeson', type: 'valg' },
  { navn: 'Personlig sponsor', vaerdi: spSponsor?.navn ?? sp.sponsorNavn ?? '—',
    slags: 'saeson', type: 'reference',
    hjaelp: 'Peger på sponsorregistret — logo og link følger med' },
  { navn: 'Spiller på andet hold', vaerdi: 'ikke sat', slags: 'saeson',
    type: 'reference', tom: true, hjaelp: 'Kun hvis spilleren spiller op eller ned' },
  { navn: 'Aktiv på akademiet', vaerdi: 'Ja', slags: 'saeson', type: 'til-fra',
    hjaelp: 'Slå fra når spilleren stopper. Profilen består' },
  { navn: 'Webadresse', vaerdi: `/spillere/${sp.slug}`, slags: 'udregnet',
    hjaelp: 'Dannes af navnet' },
  { navn: 'Hold', vaerdi: spHold ? `${spHold.navn} · årgang ${spHold.aargang}` : 'ingen',
    slags: 'udregnet',
    hjaelp: `Fødselsår ${sp.foedselsaar} findes i ${spHold?.navn}s årgange [${spAargange.join(', ')}]` },
  { navn: 'I truppen', vaerdi: spHold ? `Ja — ${truppen(spHold.id).length} i alt` : 'Nej',
    slags: 'udregnet', hjaelp: 'Aktiv + har et hold i denne sæson' },
];

/* ── Person i staben ──────────────────────────────────────────────────── */
const pe = personer.find((x) => x.navn === 'Jesper Kjær Nannerup')
        ?? personer.find((x) => x.rolle.includes('Koordinator'))
        ?? personer[0]!;

const personFelter: Felt[] = [
  { navn: 'Navn', vaerdi: pe.navn, slags: 'stam', type: 'tekst' },
  { navn: 'Portræt', vaerdi: `${pe.fotoKey}.jpg`, slags: 'stam', type: 'billede' },
  { navn: 'Sektion', vaerdi: SEKTION_NAVNE[pe.sektion], slags: 'stam', type: 'valg',
    hjaelp: 'Bestemmer hvilken gruppe personen vises i på /staben' },
  { navn: 'Rolle', vaerdi: pe.rolle || 'ikke udfyldt', slags: 'saeson', type: 'tekst',
    tom: !pe.rolle,
    hjaelp: 'Kan skifte. Står feltet tomt, vises kun navnet — det er i orden' },
  { navn: 'Telefon', vaerdi: '20 88 90 48', slags: 'saeson', type: 'tekst',
    hjaelp: 'Valgfrit. Vises kun hvis udfyldt, og bliver et klikbart nummer' },
  { navn: 'E-mail', vaerdi: 'jk@morsoe-gym.dk', slags: 'saeson', type: 'tekst',
    hjaelp: 'Valgfrit' },
  { navn: 'Rækkefølge', vaerdi: '50', slags: 'saeson', type: 'tal',
    hjaelp: 'Lavest først — bruges til at sætte daglig leder øverst' },
  { navn: 'Tilknyttet akademiet', vaerdi: 'Ja', slags: 'saeson', type: 'til-fra' },
  { navn: 'Vises i gruppe', vaerdi: SEKTION_NAVNE[pe.sektion], slags: 'udregnet',
    hjaelp: `${iSektion(pe.sektion).length} personer i denne gruppe` },
  { navn: 'Træner for hold', vaerdi: 'sættes på HOLDET', slags: 'udregnet',
    hjaelp: 'Holdet peger på personen, så en trænerudskiftning kun rettes ét sted' },
];

/* ── Sponsor ──────────────────────────────────────────────────────────── */
const spo = getSponsor('bdo') ?? sponsorerPaaNiveau('sponsor')[0]!;
const stoetter = spillere.filter((x) => x.sponsorId === spo.id).length;

const sponsorFelter: Felt[] = [
  { navn: 'Virksomhedens navn', vaerdi: spo.navn, slags: 'stam', type: 'tekst' },
  { navn: 'Logo', vaerdi: `${spo.logoKey}.png`, slags: 'stam', type: 'billede',
    hjaelp: 'Helst med gennemsigtig baggrund. Skaleres og centreres automatisk' },
  { navn: 'Hjemmeside', vaerdi: spo.url ?? '—', slags: 'saeson', type: 'url',
    hjaelp: 'Logoet bliver et link hertil' },
  { navn: 'Niveau', vaerdi: spo.niveau, slags: 'saeson', type: 'valg',
    hjaelp: 'Styrer hvor og hvor stort logoet vises' },
  { navn: 'Aftalen udløber', vaerdi: 'ikke sat', slags: 'saeson', type: 'tekst',
    tom: true, hjaelp: 'Valgfrit. Minder ledelsen om fornyelse — skjuler ikke' },
  { navn: 'Aktiv', vaerdi: 'Ja', slags: 'saeson', type: 'til-fra',
    hjaelp: 'Slå fra når sponsoratet stopper. Bliver i registret' },
  { navn: 'Vises på', vaerdi: 'Sponsorsiden', slags: 'udregnet',
    hjaelp: 'Niveauet afgør rækken — og om logoet også kommer i sidefoden' },
  { navn: 'Støtter spillere', vaerdi: String(stoetter), slags: 'udregnet',
    hjaelp: 'Talt op ud fra spillernes profiler. Sættes på SPILLEREN, ikke her' },
];

const SLAGS: Record<Slags, { navn: string; forklaring: string }> = {
  stam: { navn: 'Stamdata',
    forklaring: 'Udfyldes én gang, når posten oprettes. Ændres aldrig igen.' },
  saeson: { navn: 'Sæsondata',
    forklaring: 'Kan ændre sig undervejs eller mellem sæsoner. Rettes efter behov.' },
  udregnet: { navn: 'Udregnet',
    forklaring: 'Kan ikke redigeres. Systemet finder selv frem til værdien.' },
};

const korttyper = [
  { id: 'spiller', navn: 'Spiller', antal: spillere.length,
    felter: spillerFelter, eksempel: sp.navn, fotoKey: sp.fotoKey },
  { id: 'person', navn: 'Staben', antal: personer.length,
    felter: personFelter, eksempel: pe.navn, fotoKey: pe.fotoKey },
  { id: 'sponsor', navn: 'Sponsor', antal: sponsorerPaaNiveau('sponsor').length
      + sponsorerPaaNiveau('topsponsor').length + sponsorerPaaNiveau('partner').length + 1,
    felter: sponsorFelter, eksempel: spo.navn, fotoKey: spo.logoKey },
];

const antalAf = (felter: Felt[], sl: Slags) => felter.filter((f) => f.slags === sl).length;

const ringvirkning = [
  { felt: 'Spillerens fødselsår', rammer: ['Holdtilknytning', 'Truppen', 'Årgangsfilter', 'Forsidens tælling'] },
  { felt: 'Et portræt', rammer: ['Spillerkort', 'Profil', 'Modal', 'Alle størrelser i WebP'] },
  { felt: 'Et sponsorlogo', rammer: ['Sponsorsiden', 'Sidefoden', 'Alle deres spilleres kort', 'Spillerprofiler'] },
  { felt: 'Personens sektion', rammer: ['Gruppen på /staben', 'Optællingen i gruppen'] },
  { felt: 'Holdets årgange', rammer: ['Hele truppen', 'Alle 54 spilleres holdtilknytning'] },
];
---

<Base titel="Sådan vedligeholdes indholdet"
      beskrivelse="Hvilke felter en spiller, en person i staben og en sponsor har — og hvornår de skal vedligeholdes.">
  <div class="wrap">
    <header class="top">
      <span class="eyebrow">Demonstration · ikke et rigtigt redigeringsvindue</span>
      <h1>Sådan vedligeholdes indholdet</h1>
      <p class="lead">
        Tre korttyper skal holdes ved lige: spillere, staben og sponsorer.
        Herunder er felterne for hver af dem, med faktiske data fra
        prototypen. Farven til venstre viser <strong>hvornår</strong> feltet
        skal røres — og det er hele pointen.
      </p>
    </header>

    <section class="section">
      <div class="noegle">
        {(Object.keys(SLAGS) as Slags[]).map((sl) => (
          <div class={`noegle__i noegle__i--${sl}`}>
            <span class="noegle__navn">{SLAGS[sl].navn}</span>
            <p>{SLAGS[sl].forklaring}</p>
          </div>
        ))}
      </div>
    </section>

    {korttyper.map((k) => {
      const foto = billede(k.fotoKey);
      return (
        <section class="section" id={k.id}>
          <div class="section__head">
            <h2>{k.navn}</h2>
            <span class="antal num">
              {antalAf(k.felter, 'stam')} stamdata ·
              {' '}{antalAf(k.felter, 'saeson')} sæson ·
              {' '}{antalAf(k.felter, 'udregnet')} udregnet
              {' '}— {k.antal} i registret
            </span>
          </div>

          <div class="editor">
            <header class="editor__bar">
              <span class="editor__sti">{k.navn} / {k.eksempel}</span>
              <span class="editor__gemt">● Ændringer gemt</span>
            </header>

            <div class="editor__krop">
              <div class="editor__foto">
                {foto ? (
                  <Image src={foto} alt={k.eksempel} widths={[220, 380]}
                         sizes="190px" quality={84} loading="lazy" />
                ) : <span>billede</span>}
                <p>Træk et nyt billede herind for at erstatte</p>
              </div>
              <FeltTabel felter={k.felter} />
            </div>

            <footer class="editor__fod">
              <span class="editor__knap editor__knap--primaer">Udgiv</span>
              <span class="editor__knap">Gem kladde</span>
              <span class="editor__hist">Version 4 · se historik · rul tilbage</span>
            </footer>
          </div>
        </section>
      );
    })}

    <section class="section">
      <div class="section__head"><h2>Ringvirkning — ét felt, mange steder</h2></div>
      <p class="lead">
        Fordi tingene udregnes frem for at skrives ind flere gange, slår en
        rettelse igennem overalt af sig selv.
      </p>
      <ul class="ring">
        {ringvirkning.map((r) => (
          <li>
            <span class="ring__felt">{r.felt}</span>
            <span class="ring__pil" aria-hidden="true">→</span>
            <span class="ring__liste">{r.rammer.map((x) => <em>{x}</em>)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <div class="section__head"><h2>De fire ting man gør</h2></div>
      <div class="flows">
        <article class="flow">
          <h3>Ny spiller</h3>
          <ol>
            <li>Tryk <b>Spillere → +</b></li>
            <li>Navn og <b>fødselsår</b></li>
            <li>Træk portrættet ind fra kamerarullen</li>
            <li>Rygnummer, position, moderklub, uddannelse, sponsor</li>
            <li><b>Udgiv</b></li>
          </ol>
          <p class="flow__ud">
            Straks på det rigtige hold, i truppen, i filtrene og i tællingen.
            <strong class="num"> Ca. 40 sekunder.</strong>
          </p>
        </article>

        <article class="flow">
          <h3>Ny sponsor</h3>
          <ol>
            <li>Tryk <b>Sponsorer → +</b></li>
            <li>Navn, logo og hjemmeside</li>
            <li>Vælg <b>niveau</b></li>
            <li><b>Udgiv</b></li>
          </ol>
          <p class="flow__ud">
            Logoet står straks i den rigtige række og linker til deres side.
            Skal sponsoren støtte en elev, sættes det <strong>på spilleren</strong>
            — så tælles ”støtter N spillere” af sig selv.
            <strong class="num"> Ca. 30 sekunder.</strong>
          </p>
        </article>

        <article class="flow">
          <h3>Nogen stopper</h3>
          <ol>
            <li>Åbn posten</li>
            <li>Slå <b>Aktiv</b> fra</li>
            <li><b>Udgiv</b></li>
          </ol>
          <p class="flow__ud">
            Forsvinder fra sitet med det samme, men bliver i registret — så
            gamle nyheder ikke får døde links, og en genoptaget sponsoraftale
            er ét klik. <strong>Man sletter ikke.</strong>
          </p>
        </article>

        <article class="flow flow--fremhaev">
          <h3>Ny sæson</h3>
          <ol>
            <li>Åbn <b>Hold → U17</b></li>
            <li>Ret årgangene fra
              <b>{saeson.hold[0]!.foedselsaar.join(', ')}</b> til det nye</li>
            <li>Samme på <b>U19</b></li>
          </ol>
          <p class="flow__ud">
            <strong>Spillerne røres ikke.</strong> De rykker selv op, fordi
            holdet er defineret ved fødselsår.
          </p>
          <table class="maalt">
            <thead><tr><th>Hold</th><th class="n">Før</th><th class="n">Efter</th></tr></thead>
            <tbody>
              <tr><td>U17</td><td class="n num">25</td><td class="n num">12</td></tr>
              <tr><td>U19</td><td class="n num">29</td><td class="n num">28</td></tr>
            </tbody>
          </table>
          <p class="flow__note">
            De 13 født i 2008 rykkede selv op. De 14 født i 2006 faldt ud.
            Nul spillere redigeret.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="card cta">
        <h2>Det svære er allerede lavet</h2>
        <p>
          Kortlægningen fra <code>7.png</code> til {sp.navn} med det rigtige
          portræt og den rigtige personlige sponsor er lavet maskinelt ud af den
          nuværende side — for alle {spillere.length} spillere,
          {' '}{personer.length} i staben og 50 sponsorlogoer med links.
          Den skal aldrig laves igen.
        </p>
        <div class="cta__btns">
          <a href={`/hold/${spHold?.id ?? 'u17'}`} class="btn btn--primary">Se truppen</a>
          <a href="/staben" class="btn btn--ghost">Se staben</a>
          <a href="/sponsorer" class="btn btn--ghost">Se sponsorerne</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .top { display: flex; flex-direction: column; gap: 0.5rem;
         padding-block: 1.8rem 1.1rem; border-bottom: 2px solid var(--navy); }
  .top h1 { font-size: clamp(1.9rem, 4.8vw, 3rem); }
  .antal { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-faint); }

  .noegle { display: grid; gap: 0.9rem;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .noegle__i {
    background: var(--surface); border: 1px solid var(--line-soft);
    border-left: 5px solid var(--line); border-radius: var(--radius);
    padding: 0.9rem 1.05rem; display: flex; flex-direction: column; gap: 0.28rem;
  }
  .noegle__i--stam     { border-left-color: var(--navy); }
  .noegle__i--saeson   { border-left-color: var(--orange); }
  .noegle__i--udregnet { border-left-color: var(--text-faint); }
  .noegle__navn {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.07em; font-size: 0.86rem; font-weight: 700;
  }
  .noegle__i p { font-size: 0.88rem; color: var(--text-dim); }

  .editor {
    border: 1px solid var(--line); border-radius: 6px; overflow: hidden;
    background: var(--surface); box-shadow: var(--shadow);
  }
  .editor__bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap; padding: 0.6rem 1rem;
    background: var(--surface-2); border-bottom: 1px solid var(--line-soft);
  }
  .editor__sti { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-dim); }
  .editor__gemt { font-family: var(--font-mono); font-size: 0.72rem; color: var(--good); }

  .editor__krop {
    display: grid; gap: 1.4rem; padding: 1.2rem 1.3rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 820px) { .editor__krop { grid-template-columns: 12rem minmax(0, 1fr); } }

  .editor__foto { display: flex; flex-direction: column; gap: 0.5rem; }
  .editor__foto :global(img) {
    width: 100%; object-fit: contain; background: #fff;
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 0.3rem;
  }
  .editor__foto > span {
    display: grid; place-items: center; aspect-ratio: 3 / 4;
    border: 1px dashed var(--line); border-radius: var(--radius);
    color: var(--text-faint); font-size: 0.8rem;
  }
  .editor__foto p { font-size: 0.72rem; color: var(--text-faint); }

  .editor__fod {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    padding: 0.85rem 1.3rem; border-top: 1px solid var(--line-soft);
    background: var(--surface-2);
  }
  .editor__knap {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.09em; font-size: 0.7rem; font-weight: 700;
    border: 1px solid var(--line); border-radius: 2px;
    padding: 0.34rem 0.75rem; color: var(--text-dim);
  }
  .editor__knap--primaer {
    background: var(--orange); border-color: var(--orange); color: #241304;
  }
  .editor__hist { margin-left: auto; font-family: var(--font-mono);
                  font-size: 0.7rem; color: var(--text-faint); }

  .ring { list-style: none; margin: 1.2rem 0 0; padding: 0;
          display: flex; flex-direction: column; }
  .ring li {
    display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap;
    padding-block: 0.65rem; border-bottom: 1px dashed var(--line);
  }
  .ring li:last-child { border-bottom: 0; }
  .ring__felt {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.07em; font-size: 0.78rem; font-weight: 700;
    min-width: 12rem;
  }
  .ring__pil { color: var(--orange); }
  .ring__liste { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .ring__liste em {
    font-style: normal; font-size: 0.78rem; color: var(--text-dim);
    background: var(--surface-2); border: 1px solid var(--line-soft);
    border-radius: 20px; padding: 0.14rem 0.6rem;
  }

  .flows { display: grid; gap: 1.1rem;
           grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .flow {
    background: var(--surface); border: 1px solid var(--line-soft);
    border-radius: var(--radius); padding: 1.15rem 1.25rem 1.3rem;
    display: flex; flex-direction: column; gap: 0.6rem;
  }
  .flow--fremhaev { border-top: 3px solid var(--orange); }
  .flow h3 { font-size: 1.05rem; }
  .flow ol { margin: 0; padding-left: 1.2rem; display: flex;
             flex-direction: column; gap: 0.22rem;
             font-size: 0.9rem; color: var(--text-dim); }
  .flow ol b { color: var(--text); }
  .flow__ud { font-size: 0.9rem; color: var(--text-dim);
              padding-top: 0.4rem; border-top: 1px solid var(--line-soft); }
  .flow__note { font-size: 0.8rem; color: var(--text-faint); }

  .maalt { border-collapse: collapse; width: 100%; font-size: 0.86rem; }
  .maalt th, .maalt td { text-align: left; padding: 0.3rem 0.5rem;
                         border-bottom: 1px solid var(--line-soft); }
  .maalt th { font-family: var(--font-display); text-transform: uppercase;
              letter-spacing: 0.08em; font-size: 0.62rem; color: var(--text-faint); }
  .maalt .n { text-align: right; }
  .maalt td:first-child { font-weight: 600; }

  .cta { padding: 1.6rem 1.7rem; gap: 0.6rem; align-items: flex-start;
         background: var(--surface-2); }
  .cta h2 { font-size: 1.3rem; }
  .cta p { color: var(--text-dim); max-width: 64ch; }
  .cta code {
    font-family: var(--font-mono); font-size: 0.88em;
    background: var(--surface); border: 1px solid var(--line-soft);
    padding: 0.08em 0.34em; border-radius: 2px;
  }
  .cta__btns { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.4rem; }
</style>
