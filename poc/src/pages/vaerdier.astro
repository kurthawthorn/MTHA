---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { MOTTO, vaerdier, historie, ligatrupTal, titler, titelTekst } from '../data/vaerdier';
import { billede } from '../lib/billeder';
import { altFor } from '../data/billeder';

const top = billede('dm-jubel');
const fælles = billede('hold-udenfor');
---

<Base titel="Værdier"
      beskrivelse="Sammen er vi stærkere. Mors-Thy Håndbold Akademis værdier: dannelse og udvikling hånd i hånd, nærhed, et socialt sikkerhedsnet og høj faglig ekspertise.">
  <!-- Mottoet er akademiets eget og står på forsiden af visionsbrochuren.
       Her får det den plads, det ikke har i dag. -->
  <section class="motto">
    {top && (
      <Image src={top} alt="" class="motto__bg" widths={[760, 1200, 1700]}
             sizes="100vw" quality={56} loading="eager" />
    )}
    <div class="motto__slor"></div>
    <div class="wrap motto__in">
      <span class="eyebrow">Vores værdier</span>
      <p class="motto__citat">”{MOTTO}”</p>
      <p class="motto__under">
        Fire ord, der har fulgt akademiet siden 2012 — gennem navneskifte og
        vækst fra 4 til 38 elever.
      </p>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <div class="section__head"><h2>Det vi bygger på</h2></div>
      <div class="vgrid">
        {vaerdier.map((v, i) => (
          <article class="vkort">
            <span class="vkort__nr num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="vkort__txt">
              <h3>{v.titel}</h3>
              <p>{v.tekst}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="kilde">
        Formuleringerne er akademiets egne, fra visionsbrochuren. I dag ligger
        de låst i en PDF, hvor Google ikke kan læse dem.
      </p>
    </section>

    <!-- Akademiets stærkeste tal. Det stod nederst på side 1 i en PDF. -->
    <section class="section">
      <div class="bevis">
        <div class="bevis__tal">
          <strong class="num">{ligatrupTal.iMiljoeet}</strong>
          <span class="num">af {ligatrupTal.iTrup}</span>
        </div>
        <div class="bevis__txt">
          <h2>Det virker</h2>
          <p>
            Af de {ligatrupTal.iTrup} spillere i Mors-Thy Håndbolds ligatrup
            {' '}{ligatrupTal.saeson} er eller har {ligatrupTal.iMiljoeet} været
            en del af akademiets ungdoms- og talentmiljø.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Trofæskabet</h2>
        <span class="antal">{titelTekst}</span>
      </div>
      <ul class="pokaler">
        {titler.map((t) => (
          <li>
            <span class="pokaler__aar num">{t.aar}</span>
            <span class="pokaler__txt">
              <strong>Danmarksmestre · {t.raekke}</strong>
              {(t.modstander || t.resultat) && (
                <em>
                  {t.resultat}{t.modstander && ` i finalen mod ${t.modstander}`}
                </em>
              )}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <div class="section__head"><h2>Nyt navn, samme dna</h2></div>
      <ol class="tidslinje">
        {historie.map((m) => (
          <li>
            <span class="tidslinje__aar num">{m.aar}</span>
            <span class="tidslinje__tekst">
              {m.tekst}
              {m.tal && <em class="num">{m.tal}</em>}
            </span>
          </li>
        ))}
      </ol>
    </section>

    {fælles && (
      <section class="section">
        <figure class="bred">
          <Image src={fælles} alt={altFor('hold-udenfor')}
                 widths={[900, 1500, 2200]} sizes="100vw" quality={78} loading="lazy" />
          <figcaption>Hele akademiet samlet — sammen er vi stærkere.</figcaption>
        </figure>
      </section>
    )}

    <section class="section">
      <div class="card cta">
        <h2>Vil du være en del af det?</h2>
        <p>
          Læs om uddannelserne og optagelsen, eller ring til daglig leder
          Lars Svane Nielsen.
        </p>
        <div class="cta__btns">
          <a href="/uddannelse" class="btn btn--primary">Uddannelser</a>
          <a href="/bliv-elev" class="btn btn--ghost">Bliv elev</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .motto {
    position: relative; overflow: hidden;
    background: var(--navy-900); color: #fff;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .motto :global(.motto__bg) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 42%;
  }
  .motto__slor {
    position: absolute; inset: 0;
    background:
      linear-gradient(105deg, rgb(20 22 78 / 94%) 0%, rgb(24 26 84 / 78%) 50%,
                              rgb(24 26 84 / 34%) 100%);
  }
  .motto__in { position: relative; display: flex; flex-direction: column; gap: 0.7rem; }
  .motto .eyebrow { color: var(--orange); }
  .motto__citat {
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
    font-size: clamp(2.1rem, 7vw, 4.6rem); line-height: 1;
    letter-spacing: -0.005em; text-wrap: balance; max-width: 24ch;
    text-shadow: 0 2px 24px rgb(11 13 46 / 55%);
  }
  .motto__under { color: #C8C9EB; max-width: 52ch; font-size: 1.05rem; }

  .vgrid { display: grid; gap: 1.1rem;
           grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .vkort {
    display: grid; grid-template-columns: 2.7rem minmax(0, 1fr); gap: 0.9rem;
    background: var(--surface); border: 1px solid var(--line-soft);
    border-radius: var(--radius); border-top: 3px solid var(--orange);
    padding: 1.1rem 1.2rem 1.25rem;
  }
  .vkort__nr {
    font-family: var(--font-display); font-weight: 700; font-size: 1.5rem;
    color: var(--orange); line-height: 1.05;
  }
  .vkort__txt { display: flex; flex-direction: column; gap: 0.35rem; }
  .vkort h3 { font-size: 1rem; }
  .vkort p { font-size: 0.93rem; color: var(--text-dim); }

  .kilde { font-size: 0.82rem; color: var(--text-faint); margin-top: 1rem; max-width: 66ch; }

  .bevis {
    display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem 2.2rem;
    background: var(--navy); color: #fff;
    border-radius: var(--radius); padding: 1.6rem 1.8rem;
  }
  .bevis__tal { display: flex; flex-direction: column; line-height: 0.92; }
  .bevis__tal strong {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(3.4rem, 11vw, 6rem); color: var(--orange);
  }
  .bevis__tal span {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: 0.9rem; color: #A8ABDC;
  }
  .bevis__txt { flex: 1 1 22rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .bevis__txt h2 { font-size: 1.5rem; }
  .bevis__txt p { color: #D6D7F0; max-width: 52ch; }

  .tidslinje { list-style: none; margin: 0; padding: 0;
               display: flex; flex-direction: column; }
  .tidslinje li {
    display: grid; grid-template-columns: 4.6rem minmax(0, 1fr); gap: 1.1rem;
    padding-block: 0.85rem; border-bottom: 1px dashed var(--line);
    align-items: baseline;
  }
  .tidslinje li:last-child { border-bottom: 0; }
  .tidslinje__aar {
    font-family: var(--font-display); font-weight: 700; font-size: 1.35rem;
    color: var(--orange);
  }
  .tidslinje__tekst { display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem;
                      align-items: baseline; }
  .tidslinje__tekst em {
    font-style: normal; font-family: var(--font-display);
    text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.72rem;
    font-weight: 700; background: var(--navy); color: #fff;
    padding: 0.16rem 0.45rem; border-radius: 2px;
  }

  .antal { font-family: var(--font-display); text-transform: uppercase;
           letter-spacing: 0.09em; font-size: 0.76rem; font-weight: 600;
           color: var(--orange-600); }

  .pokaler { list-style: none; margin: 0; padding: 0;
             display: grid; gap: 0.7rem;
             grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .pokaler li {
    display: flex; align-items: center; gap: 1rem;
    background: var(--surface); border: 1px solid var(--line-soft);
    border-left: 4px solid var(--orange);
    border-radius: var(--radius); padding: 0.95rem 1.1rem;
  }
  .pokaler__aar {
    font-family: var(--font-display); font-weight: 700; font-size: 2.1rem;
    line-height: 1; color: var(--orange); flex: none;
  }
  .pokaler__txt { display: flex; flex-direction: column; gap: 0.1rem; }
  .pokaler__txt strong {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.05em; font-size: 0.8rem;
  }
  .pokaler__txt em { font-style: normal; font-size: 0.8rem; color: var(--text-faint); }

  .bred { margin: 0; }
  .bred :global(img) {
    width: 100%; height: auto; border-radius: var(--radius);
    border: 1px solid var(--line-soft);
  }
  .bred figcaption { font-size: 0.82rem; color: var(--text-faint); padding-top: 0.5rem; }

  .cta { padding: 1.6rem 1.7rem; gap: 0.6rem; align-items: flex-start;
         background: var(--surface-2); }
  .cta h2 { font-size: 1.3rem; }
  .cta p { color: var(--text-dim); max-width: 56ch; }
  .cta__btns { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.4rem; }
</style>
