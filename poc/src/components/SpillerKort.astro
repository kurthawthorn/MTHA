---
import type { Spiller } from '../data/akademi';
import { getSponsor, spillerSlug } from '../data/akademi';
import { initials } from '../lib/slug';

interface Props { spiller: Spiller }
const { spiller } = Astro.props;
const sponsor = getSponsor(spiller.sponsorId);
---

<a class="card sk"
   href={`/spillere/${spillerSlug(spiller)}`}
   data-position={spiller.position}
   data-aar={spiller.foedselsaar}>
  <div class="sk__foto">
    <!-- Pladsholder: POC'en bruger bevidst ikke fotos af eleverne.
         Feltet er der, og et rigtigt foto beskaeres automatisk om ansigtet. -->
    <span class="sk__initialer" aria-hidden="true">{initials(spiller.navn)}</span>
    <span class="sk__nr num" aria-hidden="true">{spiller.rygnummer}</span>
  </div>
  <div class="sk__body">
    <h3>{spiller.navn}</h3>
    <p class="sk__pos">{spiller.position}</p>
    <p class="sk__aar num">Årgang {spiller.foedselsaar}</p>
    {sponsor && <p class="sk__sponsor">Sponsor: <span>{sponsor.navn}</span></p>}
  </div>
</a>

<style>
  .sk { height: 100%; }
  .sk__foto {
    aspect-ratio: 3 / 4;
    background: linear-gradient(168deg, var(--navy-600), var(--navy-800));
    display: grid;
    place-items: center;
    position: relative;
  }
  .sk__initialer {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: rgb(255 255 255 / 24%);
    letter-spacing: 0.04em;
  }
  .sk__nr {
    position: absolute;
    left: 0.4rem;
    bottom: 0.3rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--orange);
    line-height: 1;
  }
  .sk__body {
    padding: 0.6rem 0.7rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }
  .sk__body h3 { font-size: 0.86rem; letter-spacing: 0.01em; }
  .sk__pos { font-size: 0.78rem; color: var(--text-dim); }
  .sk__aar { font-size: 0.72rem; color: var(--text-faint); }
  .sk__sponsor {
    margin-top: 0.3rem;
    padding-top: 0.3rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.68rem;
    color: var(--text-faint);
  }
  .sk__sponsor span { color: var(--text-dim); font-weight: 600; }
</style>
