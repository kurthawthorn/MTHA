---
import SponsorLogo from './SponsorLogo.astro';
import { sponsorerPaaNiveau, hovedsponsor } from '../data/akademi';

const hoved = hovedsponsor();
const top = sponsorerPaaNiveau('topsponsor');
const oevrige = sponsorerPaaNiveau('sponsor');

/* Sidefoden viser KUN hovedsponsor og topsponsorer.
   Hele raekken paa 42 logoer hoerer paa /sponsorer, hvor folk er kommet for at
   se den. Netop det at laegge hele sponsorvaeggen paa hver enkelt side er en af
   grundene til at den nuvaerende forside fylder 687 KB. */
const antalIAlt = 1 + top.length + oevrige.length;
---

<footer class="ft">
  <!-- Hovedsponsoren staar alene og oeverst -->
  <div class="ft__hoved">
    <div class="wrap ft__hoved-in">
      <span class="ft__label">Hovedsponsor</span>
      <a href={hoved.url} rel="noopener" target="_blank" class="ft__hovedlogo">
        <img src="/brand/thisted-forsikring.png" alt={hoved.navn}
             width="314" height="173" loading="lazy" />
      </a>
    </div>
  </div>

  <div class="ft__sponsorer">
    <div class="wrap">
      <p class="ft__label">Topsponsorer</p>
      <div class="ft__raekke">
        {top.map((s) => <SponsorLogo sponsor={s} hoejde={40} />)}
      </div>
      <p class="ft__alle">
        <a href="/sponsorer">Se alle {antalIAlt} sponsorer →</a>
      </p>
    </div>
  </div>

  <div class="wrap ft__in">
    <div class="ft__col">
      <img src="/brand/mtha-logo-officiel.png" alt="Mors-Thy Håndbold Akademi"
           width="702" height="356" class="ft__logo" loading="lazy" />
      <p>Vi skaber fremtidens stjerner.</p>
      <p class="ft__motto">”Sammen er vi stærkere”</p>
    </div>

    <div class="ft__col">
      <h2>Kontakt</h2>
      <address>
        Tranevej 4<br />7900 Nykøbing Mors<br />
        <a href="tel:+4530624304">30 62 43 04</a><br />
        <a href="mailto:info@m-tha.dk">info@m-tha.dk</a>
      </address>
    </div>

    <div class="ft__col">
      <h2>Genveje</h2>
      <ul>
        <li><a href="/nyheder">Nyheder</a></li>
        <li><a href="/hold/u17">Hold og spillere</a></li>
        <li><a href="/vaerdier">Værdier</a></li>
        <li><a href="/uddannelse">Uddannelse og eliteidræt</a></li>
        <li><a href="/staben">Staben</a></li>
        <li><a href="/bliv-elev">Bliv elev</a></li>
        <li><a href="/bliv-elev/oekonomi">Økonomi</a></li>
        <li><a href="/bolig">Bolig</a></li>
        <li><a href="/sponsorer">Sponsorer</a></li>
        <li><a href="/dokumenter">Dokumenter</a></li>
        <li><a href="/privatlivspolitik">Privatlivspolitik</a></li>
      </ul>
    </div>

    <div class="ft__col">
      <h2>Følg akademiet</h2>
      <ul>
        <li><a href="https://www.facebook.com/morsthyhaandboldakademi/"
               rel="noopener" target="_blank">Facebook</a></li>
        <li><a href="https://www.instagram.com/mors_thy_handbold_akademi/"
               rel="noopener" target="_blank">Instagram</a></li>
      </ul>
      <h3 class="ft__h2">Samarbejdspartnere</h3>
      <ul>
        <li>Morsø Kommune</li>
        <li>Morsø Gymnasium</li>
        <li>EUC Nordvest</li>
        <li>HF Mors</li>
      </ul>
    </div>
  </div>

  <div class="ft__legal">
    <div class="wrap">
      <span>© {new Date().getFullYear()} Mors-Thy Håndbold Akademi</span>
      <span>POC — ikke akademiets officielle hjemmeside</span>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--navy-900); color: #D9DAF0; margin-top: 3rem; }

  .ft__label {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.15em; font-size: 0.64rem; font-weight: 600;
    color: #8285BC; margin-bottom: 0.6rem; display: block;
  }

  .ft__hoved { background: #fff; }
  .ft__hoved-in {
    display: flex; align-items: center; justify-content: center;
    gap: 1.2rem; padding-block: 1rem; flex-wrap: wrap;
  }
  .ft__hoved .ft__label { color: #6b6d92; margin: 0; }
  .ft__hovedlogo { line-height: 0; }
  .ft__hovedlogo img { width: auto; height: 52px; }

  .ft__sponsorer { padding-block: 1.6rem; border-bottom: 1px solid rgb(255 255 255 / 12%); }
  .ft__raekke {
    display: grid; gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(122px, 1fr));
    margin-bottom: 1.4rem;
  }
  .ft__alle { font-size: 0.86rem; }
  .ft__alle a {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.09em; font-size: 0.76rem; font-weight: 600;
    color: var(--orange);
  }

  .ft__in {
    display: grid; gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 185px), 1fr));
    padding-block: 2.2rem 1.8rem;
  }
  .ft__col { display: flex; flex-direction: column; gap: 0.55rem; }
  .ft__logo {
    width: auto; height: 72px;
    background: #fff; border-radius: var(--radius); padding: 0.4rem 0.55rem;
    align-self: flex-start;
  }
  .ft__col p { font-size: 0.92rem; color: #A6A8D2; }
  .ft__motto {
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.06em; font-size: 0.88rem !important;
    font-weight: 700; color: var(--orange) !important;
  }
  /* h2, ikke h3: paa en spillerside eller en nyhed findes der ingen h2,
     saa h3 her ville springe et niveau over i overskriftshierarkiet. */
  .ft h2 { font-size: 0.78rem; letter-spacing: 0.13em; color: var(--orange); }
  .ft__h2 { margin-top: 0.8rem; }
  .ft address { font-style: normal; font-size: 0.92rem; line-height: 1.75; }
  .ft ul { list-style: none; margin: 0; padding: 0; display: flex;
           flex-direction: column; gap: 0.26rem; font-size: 0.92rem; }
  .ft a { color: #D9DAF0; text-decoration: none; }
  .ft a:hover { color: #fff; text-decoration: underline; }

  .ft__legal { border-top: 1px solid rgb(255 255 255 / 12%); padding-block: 0.9rem; }
  .ft__legal .wrap {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;
    justify-content: space-between; font-size: 0.78rem; color: #7B7EB4;
  }
</style>
