---
import { Image } from 'astro:assets';
import type { Sponsor } from '../data/akademi';
import { billede } from '../lib/billeder';
import { billedUrl, billedSrcset } from '../lib/sanity';
import { redigerbar } from '../lib/redigering';

interface Props {
  sponsor: Sponsor;
  hoejde?: number;
  /**
   * Mindre luft omkring logoet. Til de smaa visninger — spillerkortet i
   * truppen — hvor den fulde polstring ville gøre pladen større end logoet.
   */
  kompakt?: boolean;
  /**
   * Slås fra når logoet står inde i et andet link. Et <a> inde i et <a> er
   * ugyldig HTML, og browserne retter det op på hver sin måde — resultatet er
   * at en del af det ydre link holder op med at kunne klikkes. Det er præcis
   * situationen på spillerkortet, som selv er et link til profilen.
   */
  linkbar?: boolean;
  /**
   * Sæt til true for at gøre logoet klikbart i Sanitys Presentation mode, så
   * det åbner SPONSORDOKUMENTET.
   *
   * Slået fra som standard, fordi logoet ofte står inde i en anden
   * sammenhæng: på et spillerkort er det rigtige felt at redigere spillerens
   * "Personlig sponsor", ikke sponsorens logo. Var mærket altid på, ville det
   * inderste vinde, og et klik ville føre til det forkerte sted.
   */
  redigerbart?: boolean;
}
const { sponsor, hoejde = 44, kompakt = false, linkbar = true,
        redigerbart = false } = Astro.props;

/**
 * Billedet kan komme tre steder fra, i denne rækkefølge:
 *   1. Sanitys CDN, hvis logoet er uploadet i studioet
 *   2. den lokale fil i src/assets/logoer/, fra udtrækket af m-tha.dk
 *   3. hvis ingen af dem findes: navnet som tekst
 *
 * Det gør at et logo en redaktør uploader i morgen virker med det samme,
 * uden at de 50 der allerede er der, skal røres.
 */
const fraSanity = sponsor.logoUrl;
const lokal = fraSanity ? undefined : billede(sponsor.logoKey);

const somLink = linkbar && Boolean(sponsor.url);
const Tag = somLink ? 'a' : 'div';
const bredder = [hoejde * 3, hoejde * 6];
const red = redigerbart ? redigerbar('sponsor', sponsor.docId, 'logo') : undefined;
---

<Tag class:list={['logo', kompakt && 'logo--kompakt']}
     href={somLink ? sponsor.url : undefined}
     rel={somLink ? 'noopener' : undefined}
     target={somLink ? '_blank' : undefined}
     style={`--h:${hoejde}px`}
     title={sponsor.navn}
     data-sanity={red}>
  {fraSanity ? (
    <img src={billedUrl(fraSanity, { b: hoejde * 6, kvalitet: 88 })}
         srcset={billedSrcset(fraSanity, bredder, { kvalitet: 88 })}
         sizes={`${hoejde * 4}px`}
         alt={sponsor.navn} loading="lazy" decoding="async" />
  ) : lokal ? (
    <Image src={lokal} alt={sponsor.navn} widths={[160, 320]}
           sizes={`${hoejde * 4}px`} quality={88} loading="lazy" />
  ) : (
    <span class="logo__tekst">{sponsor.navn}</span>
  )}
</Tag>

<style>
  /* Logoerne kommer i vidt forskellige formater og baggrunde — nogle med
     transparens, nogle med hvid bund. Derfor står de alle på en hvid plade
     med samme højde, så rækken bliver rolig. */
  .logo {
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    padding: 0.5rem 0.7rem;
    height: calc(var(--h) + 1.4rem);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  a.logo:hover { border-color: var(--navy-300); transform: translateY(-2px); }

  /* Kompakt: kun den luft der skal til for at logoet ikke rører rammen. */
  .logo--kompakt {
    padding: 0.22rem 0.36rem;
    height: calc(var(--h) + 0.62rem);
  }

  .logo :global(img), .logo img {
    max-height: var(--h);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .logo__tekst {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.74rem;
    font-weight: 600;
    color: #44476b;
    text-align: center;
  }
</style>
