---
import { hovedsponsor } from '../data/akademi';

const nav = [
  { href: '/nyheder', label: 'Nyheder' },
  { href: '/hold/u17', label: 'Hold' },
  { href: '/vaerdier', label: 'Værdier' },
  { href: '/uddannelse', label: 'Uddannelse' },
  { href: '/staben', label: 'Staben' },
  { href: '/om-akademiet', label: 'Om akademiet' },
  { href: '/sponsorer', label: 'Sponsorer' },
];
const sponsor = hovedsponsor();
const path = Astro.url.pathname;
---

{/*
  Hvid header — bevidst valg, ikke en tilfældighed.

  Akademiets logo er navy tekst og orange bold på gennemsigtig baggrund. Det er
  designet til lys bund. På en navy header ville de navy dele forsvinde, og
  derfor stod logoet før på en hvid plade — hvilket gjorde gennemsigtigheden
  usynlig og holdt logoet kunstigt lille.

  Med hvid bund kan logoet stå frit og i fuld størrelse, og navy bruges i
  stedet som accent: menutekst, underkant og den aktive markering.
*/}
<header class="hdr">
  <div class="wrap hdr__in">
    {/*
      Lockup: akademiets mærke og hovedsponsoren står sammen, adskilt af en
      lodret streg. Det er sådan et hovedsponsorat ser ud — en partner ved
      siden af mærket, ikke en logo stoppet ind i menuens hjørne. Samtidig
      falder headeren ned i én række, og tomrummet i midten forsvinder.
    */}
    <div class="hdr__maerke">
      <a href="/" class="hdr__logo" aria-label="Mors-Thy Håndbold Akademi — forside">
        <img src="/brand/mtha-logo-officiel.png" alt="Mors-Thy Håndbold Akademi"
             width="702" height="356" />
      </a>

      <p class="hdr__sponsor">
        <span>Hovedsponsor</span>
        <a href={sponsor.url} rel="noopener" target="_blank">
          <img src="/brand/thisted-forsikring.png" alt={sponsor.navn}
               width="314" height="173" />
        </a>
      </p>
    </div>

    <nav aria-label="Hovedmenu">
      <ul>
        {nav.map((i) => (
          <li>
            <a href={i.href}
               aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/bliv-elev" class="btn btn--primary hdr__cta">Bliv elev</a>
  </div>
</header>

<style>
  .hdr {
    background: #fff;
    border-bottom: 3px solid var(--navy);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    gap: 1rem 1.8rem;
    padding-block: 0.8rem;
    flex-wrap: wrap;
  }

  /* Mærke-lockup: MTHA og hovedsponsoren side om side */
  .hdr__maerke {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex: none;
  }

  /* Logoet står frit — ingen plade, ingen ramme. Højden er sat efter at det er
     et bredt mærke (702 x 356), så 78 px højde giver ca. 154 px bredde. */
  .hdr__logo { flex: none; line-height: 0; }
  .hdr__logo img { width: auto; height: 78px; }

  /* Den lodrette streg gør de to mærker til én enhed frem for to løse logoer */
  .hdr__sponsor {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    padding-left: 1.15rem;
    border-left: 1px solid var(--line);
  }
  .hdr__sponsor span {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.58rem;
    font-weight: 600;
    color: #7a7c9e;
  }
  .hdr__sponsor a { line-height: 0; }
  .hdr__sponsor img { width: auto; height: 34px; }

  nav { margin-left: auto; }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.3rem;
    flex-wrap: wrap;
  }
  nav a {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s, color 0.15s;
  }
  nav a:hover { border-bottom-color: var(--navy-300); }
  nav a[aria-current='page'] {
    border-bottom-color: var(--orange);
    color: var(--orange-600);
  }

  .hdr__cta { flex: none; }

  /* Mørk visning: headeren bliver ikke navy, men en meget lys plade, så
     logoet stadig kan læses. Det er mærket der bestemmer, ikke temaet. */
  @media (prefers-color-scheme: dark) {
    .hdr { background: #F2F3FA; border-bottom-color: var(--orange); }
    nav a { color: #23256F; }
    nav a[aria-current='page'] { color: #A85E06; }
    .hdr__sponsor span { color: #6b6d92; }
  }

  /* Under 1040 px er der ikke plads til lockup og menu på samme linje.
     Menuen falder ned under, men mærket bliver ét. */
  @media (max-width: 1040px) {
    .hdr__in { gap: 0.7rem 1rem; }
    .hdr__logo img { height: 64px; }
    .hdr__sponsor img { height: 30px; }
    nav { margin-left: 0; order: 3; flex: 1; }
    nav ul { gap: 1rem; }
    nav a { font-size: 0.78rem; }
    .hdr__cta { margin-left: auto; }
  }
  @media (max-width: 560px) {
    .hdr__logo img { height: 52px; }
    .hdr__maerke { gap: 0.8rem; }
    .hdr__sponsor { padding-left: 0.8rem; }
    .hdr__sponsor img { height: 26px; }
    .hdr__sponsor span { font-size: 0.52rem; }
  }
</style>
