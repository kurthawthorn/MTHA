---
import type { Blok } from '../data/nyheder';

/**
 * Viser portable text fra Sanity.
 *
 * Der findes færdige biblioteker til dette, men blokformen er så enkel at et
 * bibliotek ville koste mere end det gav: fem blokke, tre stilarter og to
 * markeringer. Her er det 30 linjer og ingen afhængighed.
 *
 * Punkter samles undervejs, fordi portable text ikke har et lister-begreb —
 * hver linje er sin egen blok med `listItem: 'bullet'`. Uden samlingen ville
 * hvert punkt blive sin egen <ul>.
 */
interface Props {
  blokke: Blok[];
}
const { blokke } = Astro.props;

type Element = { slags: 'blok'; blok: Blok } | { slags: 'liste'; punkter: Blok[] };

const elementer: Element[] = [];
for (const b of blokke) {
  if (b.listItem === 'bullet') {
    const sidste = elementer.at(-1);
    if (sidste?.slags === 'liste') sidste.punkter.push(b);
    else elementer.push({ slags: 'liste', punkter: [b] });
  } else {
    elementer.push({ slags: 'blok', blok: b });
  }
}

/** Én blok kan have flere tekststykker med hver sin markering. */
const Stykker = 'span';
---

<div class="rt">
  {elementer.map((e) => {
    if (e.slags === 'liste') {
      return (
        <ul>
          {e.punkter.map((p) => (
            <li>
              {p.children.map((s) => (
                s.marks?.includes('strong') ? <strong>{s.text}</strong>
                : s.marks?.includes('em') ? <em>{s.text}</em>
                : <Stykker set:text={s.text} />
              ))}
            </li>
          ))}
        </ul>
      );
    }

    const indhold = e.blok.children.map((s) => (
      s.marks?.includes('strong') ? <strong>{s.text}</strong>
      : s.marks?.includes('em') ? <em>{s.text}</em>
      : <Stykker set:text={s.text} />
    ));

    if (e.blok.style === 'h2') return <h2>{indhold}</h2>;
    if (e.blok.style === 'blockquote') return <blockquote>{indhold}</blockquote>;
    return <p>{indhold}</p>;
  })}
</div>

<style>
  .rt { display: flex; flex-direction: column; gap: 1rem; max-width: 65ch; }
  .rt p { color: var(--text-dim); }
  .rt h2 { font-size: 1.3rem; margin-top: 0.6rem; }
  .rt ul { margin: 0; padding-left: 1.2rem; color: var(--text-dim);
           display: flex; flex-direction: column; gap: 0.25rem; }
  .rt blockquote {
    margin: 0; padding: 0.4rem 0 0.4rem 1rem;
    border-left: 3px solid var(--orange);
    font-size: 1.08rem; color: var(--text);
  }
  .rt strong { color: var(--text); font-weight: 650; }
  .rt em { color: var(--text-faint); font-style: normal; }
</style>
