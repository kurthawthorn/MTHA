---
import { Image } from 'astro:assets';
import { billede } from '../lib/billeder';
import { billedUrl, billedSrcset } from '../lib/sanity';
import { danishDate } from '../lib/slug';
import { redigerbar } from '../lib/redigering';

interface Props {
  /**
   * Overskriftsniveau. Et kort under en <h2> skal bruge h3; staar kortene
   * direkte under sidens <h1> — som paa /nyheder og /hold — skal de bruge h2,
   * ellers springes et niveau over i hierarkiet.
   */
  niveau?: 2 | 3;
  /** Sanity-dokumentets `_id`. Kun til klik-til-felt — se lib/redigering.ts. */
  docId?: string;
  slug: string;
  titel: string;
  dato: Date;
  kategori: string;
  resume: string;
  kilde: 'cms' | 'instagram';
  fotoKey?: string;
  fotoUrl?: string;
}
const { slug, titel, dato, kategori, resume, kilde, fotoKey, fotoUrl,
        docId, niveau = 3 } = Astro.props;
const red = (felt: string) => redigerbar('nyhed', docId, felt);
/* Sanitys CDN foerst, den lokale fil som reserve */
const fraSanity = fotoUrl;
const foto = fraSanity ? undefined : billede(fotoKey);

/* Pladsholder-vinkel varieres ud fra overskriften, saa kortene ikke ser ens ud
   naar billederne ikke er hentet. */
const vinkel = 120 + ([...titel].reduce((a, c) => a + c.charCodeAt(0), 0) % 90);
const Overskrift = `h${niveau}` as 'h2' | 'h3';
---

<a class="card nk" href={`/nyheder/${slug}`}>
  <div class:list={['nk__img', !foto && !fraSanity && 'nk__img--tom']}
       style={`--v:${vinkel}deg`}>
    {fraSanity ? (
      <img src={billedUrl(fraSanity, { b: 520, h: 293, kvalitet: 80 })}
           srcset={billedSrcset(fraSanity, [320, 520, 760], { forhold: 9 / 16, kvalitet: 80 })}
           sizes="(max-width: 700px) 92vw, 340px"
           alt="" data-sanity={red('foto')} loading="lazy" decoding="async" />
    ) : foto ? (
      <Image src={foto} alt="" widths={[320, 520, 760]}
             sizes="(max-width: 700px) 92vw, 340px" quality={80} loading="lazy" />
    ) : null}
    <span class="pill" data-sanity={red('kategori')}>{kategori}</span>
    {kilde === 'instagram' && <span class="nk__auto">via Instagram</span>}
  </div>
  <div class="nk__body">
    <Overskrift data-sanity={red('titel')}>{titel}</Overskrift>
    <time datetime={dato.toISOString()} data-sanity={red('dato')}>{danishDate(dato)}</time>
    <p data-sanity={red('resume')}>{resume}</p>
  </div>
</a>

<style>
  .nk { height: 100%; }
  .nk__img {
    aspect-ratio: 16 / 9;
    position: relative;
    display: flex; align-items: flex-start;
    padding: 0.6rem;
    overflow: hidden;
    background: var(--navy-800);
  }
  .nk__img :global(img), .nk__img img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  a.card:hover .nk__img :global(img), a.card:hover .nk__img img {
    transform: scale(1.04);
  }

  .nk__img--tom {
    background: linear-gradient(var(--v), var(--navy) 0%, var(--navy-600) 55%, var(--orange) 190%);
  }

  .nk__img .pill { position: relative; z-index: 1; }
  .nk__auto {
    position: absolute; right: 0.6rem; bottom: 0.6rem; z-index: 1;
    font-family: var(--font-display); text-transform: uppercase;
    letter-spacing: 0.1em; font-size: 0.6rem; font-weight: 600;
    color: #fff; background: rgb(0 0 0 / 48%);
    padding: 0.15rem 0.45rem; border-radius: 2px;
  }

  .nk__body {
    padding: 0.85rem 0.95rem 1.05rem;
    display: flex; flex-direction: column; gap: 0.35rem;
  }
  .nk__body h2, .nk__body h3 { font-size: 1.02rem; letter-spacing: 0.02em; }
  .nk__body time { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-faint); }
  .nk__body p { font-size: 0.9rem; color: var(--text-dim); }
</style>
